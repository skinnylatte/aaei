---
// Answer sheet for a case study: how each version is built, what the checks look for,
// and the expected behaviour of every scenario, generated by running the case study itself.
import { OWASP, VARIANT_LABELS, type Expected, type OwaspId, type Variant } from '../../lib/case-studies/runner';

interface Scenario { id: string; name: string; description: string; lesson: string; owasp: OwaspId[]; results: Expected[] }
interface Props {
  title: string;
  caseHref: string;
  versions: Record<Variant, string>;
  checks: { label: string; kind: string }[];
  scenarios: Scenario[];
  decision: string[];
  note?: string;
}
const { title, caseHref, versions, checks, scenarios, decision, note } = Astro.props;
const coverage = (Object.keys(OWASP) as OwaspId[]).map((id) => ({ id, name: OWASP[id], scenarios: scenarios.map((s, i) => ({ ...s, n: i + 1 })).filter((s) => s.owasp.includes(id)) }));
const verdict = (r: Expected) => (r.failed.length ? `${r.failed.length} failed` : r.applied ? 'Passes' : 'No checks apply');
---

<div class="intro"><h1 class="headline">Answer sheet: {title}</h1><p>What each version does in every scenario, and which checks it fails. This page is produced by running the case study itself, so it matches exactly what trainees will see.</p><p><a class="text-link" href={caseHref}>Open the case study <span aria-hidden="true">→</span></a></p></div>

<section class="answer-section" aria-labelledby="versions-title">
  <h2 id="versions-title">How each version is built</h2>
  <dl class="versions-built">
    {(['weak', 'patched', 'safe'] as Variant[]).map((v) => <div><dt>{VARIANT_LABELS[v]}</dt><dd>{versions[v]}</dd></div>)}
  </dl>
</section>

<section class="answer-section" aria-labelledby="checks-title">
  <h2 id="checks-title">What the checks look for</h2>
  <p>A check only applies when a scenario is relevant to it. "Passes" means every check that applied was met.</p>
  <ul class="check-kinds">{checks.map((c) => <li><strong>{c.label}</strong> <span class="pill">{c.kind}</span></li>)}</ul>
</section>

<section class="answer-section" aria-labelledby="owasp-title">
  <h2 id="owasp-title">OWASP coverage</h2>
  <p>Mapped to the OWASP Top 10 for LLM Applications, 2025 edition. {coverage.filter((c) => c.scenarios.length).length} of the 10 risks are covered here.</p>
  <div class="table-scroll">
    <table class="results owasp-table">
      <caption>Which scenarios exercise each OWASP risk</caption>
      <thead><tr><th scope="col">Risk</th><th scope="col">Scenarios</th></tr></thead>
      <tbody>
        {coverage.map((c) => (
          <tr class={c.scenarios.length ? '' : 'owasp-none'}>
            <th scope="row"><span class="owasp-id">{c.id}</span> {c.name}</th>
            <td>{c.scenarios.length ? c.scenarios.map((s, i) => <Fragment>{i > 0 && ', '}<a href={`#${s.id}`}>{s.n}. {s.name}</a></Fragment>) : 'Not covered in this case study'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<section class="answer-section" aria-labelledby="glance-title">
  <h2 id="glance-title">At a glance</h2>
  <div class="table-scroll">
    <table class="results glance">
      <caption>Checks failed per scenario and version</caption>
      <thead><tr><th scope="col">Scenario</th><th scope="col">OWASP</th>{(['weak', 'patched', 'safe'] as Variant[]).map((v) => <th scope="col">{VARIANT_LABELS[v]}</th>)}</tr></thead>
      <tbody>
        {scenarios.map((s, i) => (
          <tr>
            <th scope="row"><a href={`#${s.id}`}>{i + 1}. {s.name}</a></th>
            <td class="nowrap">{s.owasp.length ? s.owasp.join(', ') : 'None'}</td>
            {s.results.map((r) => <td><span class={`pill ${r.failed.length ? 'bad' : 'ok'}`}>{verdict(r)}</span></td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<section class="answer-section" aria-labelledby="scenarios-title">
  <h2 id="scenarios-title">Scenario by scenario</h2>
  {scenarios.map((s, i) => (
    <article class="scenario" id={s.id} aria-labelledby={`${s.id}-title`}>
      <h3 id={`${s.id}-title`}>{i + 1}. {s.name}</h3>
      <p class="owasp-tags">{s.owasp.length ? s.owasp.map((id) => <span class="owasp-tag"><span class="owasp-id">{id}</span> {OWASP[id]}</span>) : <span class="owasp-tag owasp-tag-quiet">Not a security scenario: tests usefulness or fairness</span>}</p>
      <p class="scenario-what">{s.description}</p>
      <div class="scenario-versions">
        {s.results.map((r) => (
          <div class="scenario-version">
            <h4>{VARIANT_LABELS[r.variant]} <span class={`pill ${r.failed.length ? 'bad' : 'ok'}`}>{verdict(r)}</span></h4>
            <ul>{r.lines.map((line) => <li>{line}</li>)}</ul>
            {r.failed.length > 0 && <p class="failed-label">Fails:</p>}
            {r.failed.length > 0 && <ul class="failed">{r.failed.map((f) => <li><strong>{f.label}.</strong> {f.detail}</li>)}</ul>}
          </div>
        ))}
      </div>
      <p class="lesson"><strong>What to notice:</strong> {s.lesson}</p>
    </article>
  ))}
</section>

<section class="answer-section" aria-labelledby="decision-title">
  <h2 id="decision-title">The deployment decision</h2>
  {decision.map((p) => <p class="decision-text">{p}</p>)}
  {note && <p class="note">{note}</p>}
</section>
