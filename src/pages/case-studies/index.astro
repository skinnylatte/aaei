---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';

const studies = [
  {
    id: 'northstar-air',
    href: '/case-studies/northstar-air/',
    title: 'Northstar Air customer service',
    lede: 'An airline support agent that looks up bookings and changes where itineraries are sent.',
    tags: ['Authorization', 'Privacy', 'Human escalation'],
  },
  {
    id: 'harbour-city',
    href: '/case-studies/harbour-city/',
    title: 'Harbour City Services grant assistant',
    lede: 'A multilingual public services assistant answering residents\' questions about a household grant.',
    tags: ['Multilingual', 'Misinformation', 'Fairness'],
  },
];

// The workshop's learning outcomes, and where on these case studies each one is practised.
const outcomes = [
  { outcome: 'Identify and prioritize AI failure modes', where: 'Step 2, Before you start: list what could go wrong, who is harmed and how badly, then rank it.' },
  { outcome: 'Conduct structured adversarial testing and red teaming', where: 'Step 3, Start testing AI: send attack techniques and everyday requests, and mark each failure you find.' },
  { outcome: 'Apply OWASP GenAI security concepts', where: 'Every check is tagged with its risk from the OWASP Top 10 for LLM Applications, such as prompt injection, excessive agency, sensitive information disclosure and misinformation.' },
  { outcome: 'Turn red-team findings into repeatable evaluation cases', where: 'Marking a failure as found saves the result as evidence. The test report replays every technique you sent on a fresh session, so each one becomes a test you can run again.' },
  { outcome: 'Design practical criteria for evaluating AI behavior', where: 'Say what a failure looks like for each mode on your worksheet, then compare it with the pass or fail checks the report scores each version against.' },
  { outcome: 'Test authorization boundaries, tool use and human oversight', where: 'Try to reach another passenger’s booking or another resident’s case, and see whether a human agent catches it.' },
  { outcome: 'Evaluate mitigations and run regression tests', where: 'Every case study has a weak, a patched and a safe version. Send the same message to all three and compare.' },
  { outcome: 'Build credible evidence to support deployment decisions', where: 'Step 4, View the report: a deploy decision for each version, and what to fix and who owns it.' },
];

// Mentions of the OWASP Top 10 link to it, wherever they appear on this page.
const OWASP_TOP_10 = 'https://genai.owasp.org/llm-top-10/';
const linkOwasp = (text: string) => text.split(/((?:OWASP )?Top 10 for LLM Applications)/).map((part, i) => (i % 2 ? { text: part, href: OWASP_TOP_10 } : part));

const resources = [
  {
    id: 'learn',
    title: 'Learn to evaluate AI systems',
    intro: 'Start here if you are new to evals. The first two are aimed at engineers and product managers; the LinkedIn course needs no coding.',
    links: [
      { href: 'https://maven.com/parlance-labs/evals', title: 'AI Evals For Engineers & PMs', source: 'Hamel Husain and Shreya Shankar, Maven', note: 'A hands-on course on designing evals, error analysis and running evals in CI for AI products in production.' },
      { href: 'https://hamel.dev/', title: 'Hamel Husain’s blog', source: 'hamel.dev', note: 'Practical writing on building evals to debug and measure AI products.' },
      { href: 'https://www.linkedin.com/learning/ai-evaluations-for-everyone-how-non-engineers-can-build-better-ai-systems-with-humane-intelligence', title: 'AI Evaluations for Everyone: How Non-Engineers Can Build Better AI Systems', source: 'Humane Intelligence, LinkedIn Learning', note: 'A course for non-engineers on running human-centred evaluations that surface bias and misalignment.' },
      { href: 'https://humane-intelligence.org/product/red-teaming-app/', title: 'Red Teaming Web Application', source: 'Humane Intelligence', note: 'A platform for running red teaming events and contextual evaluations, including multilingual testing.' },
    ],
  },
  {
    id: 'research',
    title: 'Follow the research',
    intro: 'The field moves quickly. Follow AI safety and security researchers on LinkedIn, and check these sources for new papers.',
    links: [
      { href: 'https://arxiv.org/list/cs.CR/recent', title: 'arXiv: Cryptography and Security (cs.CR)', source: 'arXiv', note: 'New preprints on attacks and defences, including prompt injection and jailbreaks.' },
      { href: 'https://arxiv.org/list/cs.AI/recent', title: 'arXiv: Artificial Intelligence (cs.AI)', source: 'arXiv', note: 'New preprints on AI safety, alignment and evaluation.' },
      { href: 'https://iclr.cc/', title: 'ICLR', source: 'International Conference on Learning Representations', note: 'Browse the accepted papers and workshops each year for safety and evaluation work.' },
      { href: 'https://icml.cc/', title: 'ICML', source: 'International Conference on Machine Learning', note: 'Another major venue; its workshops often focus on trustworthy and secure AI.' },
    ],
  },
  {
    id: 'governance',
    title: 'Understand governance frameworks',
    intro: 'Frameworks give you a shared language for risk, and help you explain test results to the people who decide whether a system ships.',
    links: [
      { href: 'https://www.nist.gov/itl/ai-risk-management-framework', title: 'AI Risk Management Framework (AI RMF)', source: 'NIST', note: 'A voluntary framework for mapping, measuring and managing AI risk, with a companion profile for generative AI.' },
      { href: 'https://www.vsu.edu/about/leadership/vp-for-academic-affairs/crai/frame.php', title: 'Forum for Real-World AI Measurement and Evaluation (FRAME)', source: 'Reva Schwartz and Dr. Gabriella Waters, Virginia State University', note: 'Evaluates how AI systems perform in real use, with evidence to support deployment decisions.' },
    ],
  },
  {
    id: 'industry',
    title: 'Learn from industry groups',
    intro: 'These groups publish research, guidelines and best practices. Check back regularly, as they update often.',
    links: [
      { href: OWASP_TOP_10, title: 'OWASP Top 10 for LLM Applications', source: 'OWASP Gen AI Security Project', note: 'The ten most serious security risks for applications built on large language models, from prompt injection to unbounded consumption. The checks in these case studies are tagged with them.' },
      { href: 'https://genai.owasp.org/', title: 'OWASP Gen AI Security Project', source: 'OWASP', note: 'Home of the Top 10 for LLM Applications and the Top 10 for Agentic Applications.' },
      { href: 'https://aaif.io/', title: 'Agentic AI Foundation (AAIF)', source: 'Linux Foundation', note: 'Open standards for AI agents, including the Model Context Protocol (MCP) and AGENTS.md.' },
    ],
  },
];

const audiences = ['Product managers', 'Engineers', 'Lawyers', 'Risk and compliance', 'Cybersecurity', 'AI governance', 'Public sector', 'Leaders deploying AI'];

const toc = [
  { id: 'case-studies', label: 'Case Studies' },
  { id: 'what-you-learn', label: 'What You Will Learn' },
  { id: 'tools-and-resources', label: 'Tools and Resources' },
];
---

<CaseStudyLayout title="Case studies" description="Hands-on case studies that show how AI systems fail in practice, from the Asian AI Evaluation Institute.">
  <div class="intro intro-split cs-hero">
    <div>
      <h1 class="headline">Break AI Before Deploying AI</h1>
      <p>A hands-on workshop on evaluating and red teaming generative and agentic AI systems before deployment. You will work with AI applications and learn how to make them fail, then turn those failures into repeatable evaluations that support better deployment decisions.</p>
    </div>
    <aside class="glance" aria-labelledby="glance-title">
      <h2 id="glance-title">At a glance</h2>
      <dl>
        <div><dt>Case studies</dt><dd>2, about 30 to 35 minutes each</dd></div>
        <div><dt>Each one</dt><dd>Read the brief, rank what could go wrong, then test three versions side by side</dd></div>
        <div><dt>Data</dt><dd>Synthetic only. No coding needed.</dd></div>
      </dl>
      <h3>Who it is for</h3>
      <p>Anyone who builds, buys, deploys, governs or oversees AI.</p>
      <ul class="audience-chips">{audiences.map((a) => <li>{a}</li>)}</ul>
    </aside>
  </div>
  <nav class="page-toc cs-toc" aria-labelledby="toc-title">
    <h2 id="toc-title" class="visually-hidden">On this page</h2>
    <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ol>
  </nav>

  <section id="case-studies" class="toc-section" aria-labelledby="case-studies-title">
    <h2 id="case-studies-title" class="section-title">Case Studies</h2>
    <p class="section-lede">Two synthetic AI systems, each with a weak, a patched and a safe version. Everything runs in your browser and nothing real is sent.</p>
  <ul class="case-grid">
    {studies.map((s) => (
      <li class={`case-tile case-tile-${s.id}`}>
        <h3><a href={s.href}>{s.title}</a></h3>
        <p class="case-tile-lede">{s.lede}</p>
        <div class="tag-list">{s.tags.map((t) => <span>{t}</span>)}</div>
        <div class="case-tile-bottom"><p>About 30 to 35 minutes</p><span class="button" aria-hidden="true">Open <span>→</span></span></div>
      </li>
    ))}
  </ul>
  </section>

  <section id="what-you-learn" class="toc-section" aria-labelledby="what-you-learn-title">
    <h2 id="what-you-learn-title" class="section-title">What You Will Learn</h2>
    <p class="section-lede">Each workshop outcome, and where in the case studies you practise it.</p>
    <ul class="outcome-list">
      {outcomes.map((o) => (
        <li>
          <h3>{o.outcome}</h3>
          <p>{linkOwasp(o.where).map((part) => (typeof part === 'string' ? part : <a class="text-link" href={part.href} rel="noopener">{part.text}</a>))}</p>
        </li>
      ))}
    </ul>
  </section>

  <section id="tools-and-resources" class="toc-section" aria-labelledby="tools-and-resources-title">
    <h2 id="tools-and-resources-title" class="section-title">Tools and Resources</h2>
    <p class="section-lede">Where to go next once you have worked through the case studies: courses and tools for running evaluations, and the research, frameworks and industry groups worth following.</p>
    <div class="resource-groups">
      {resources.map((g) => (
        <section class="resource-group" aria-labelledby={`res-${g.id}`}>
          <h3 id={`res-${g.id}`}>{g.title}</h3>
          <p class="resource-intro">{g.intro}</p>
          <ul class="resource-list">
            {g.links.map((l) => (
              <li>
                <a href={l.href} rel="noopener">{l.title}</a>
                <span class="resource-source">{l.source}</span>
                <p>{linkOwasp(l.note).map((part) => (typeof part === 'string' ? part : <a class="text-link" href={part.href} rel="noopener">{part.text}</a>))}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</CaseStudyLayout>
