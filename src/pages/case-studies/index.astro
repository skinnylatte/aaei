---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';

const studies = [
  {
    id: 'northstar-air',
    href: '/case-studies/northstar-air/',
    title: 'Northstar Air customer service',
    lede: 'An airline support agent that looks up bookings and changes where itineraries are sent.',
    tags: ['Authorization', 'Privacy', 'Human escalation'],
  },
  {
    id: 'tidewater',
    href: '/case-studies/tidewater/',
    title: 'Tidewater Logistics invoice approvals',
    lede: 'An accounts-payable agent that reads invoices and prepares payments for a finance officer to approve.',
    tags: ['Prompt injection', 'Excessive agency', 'Human approval'],
  },
  {
    id: 'harbour-city',
    href: '/case-studies/harbour-city/',
    title: 'Harbour City Services grant assistant',
    lede: 'A multilingual public services assistant answering residents\' questions about a household grant.',
    tags: ['Multilingual', 'Misinformation', 'Fairness'],
  },
];
---

<CaseStudyLayout title="Case studies" description="Hands-on case studies that show how AI systems fail in practice, from the Asian AI Evaluation Institute.">
  <div class="intro"><h1 class="headline">Case studies</h1><p>Three synthetic AI systems to test the way you would before deployment. Each has a weak, a patched and a safe version. Everything runs in your browser and nothing real is sent.</p></div>
  <ul class="case-grid">
    {studies.map((s) => (
      <li class={`case-tile case-tile-${s.id}`}>
        <h2><a href={s.href}>{s.title}</a></h2>
        <p class="case-tile-lede">{s.lede}</p>
        <div class="tag-list">{s.tags.map((t) => <span>{t}</span>)}</div>
        <div class="case-tile-bottom"><p>About 30 to 35 minutes</p><span class="button" aria-hidden="true">Open <span>→</span></span></div>
      </li>
    ))}
  </ul>
</CaseStudyLayout>
