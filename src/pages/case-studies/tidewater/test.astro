---
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
import Checklist from '../../../components/case-studies/Checklist.astro';
import { LOCATION_LABELS } from '../../../lib/case-studies/tidewater';
import { TECHNIQUES, TECHNIQUE_SECTIONS } from '../../../lib/case-studies/tidewater-techniques';

const techniqueById = Object.fromEntries(TECHNIQUES.map((t) => [t.id, t]));
const sections = TECHNIQUE_SECTIONS.map((s) => ({ ...s, techniques: s.ids.map((id) => techniqueById[id]) }));
const grouped = sections.flatMap((s) => s.ids);
if (grouped.length !== TECHNIQUES.length || TECHNIQUES.some((t) => !grouped.includes(t.id))) throw new Error('Every Tidewater attack must appear in exactly one sidebar group.');

const versions = ['weak', 'patched', 'safe'];
---

<CaseStudyLayout title="Tidewater Logistics: start testing AI" description="An accounts-payable agent that reads supplier invoices and prepares payments. Find where it fails, then prove the fix." backLink={{ href: '/case-studies/', label: 'All case studies' }} steps={{ slug: 'tidewater', page: 3 }}>
  <div class="intro test-intro"><h1 class="headline">Start testing AI</h1><p>Test Tidewater against your list from <a class="text-link" href="/case-studies/tidewater/before/">Before you start</a>, and note anything new. Every attack runs in three stages: you send it, you approve or reject what each version shows you, then you see what really happened.</p></div>

  <div class="workbench">
    <aside class="panel techniques" aria-labelledby="techniques-title">
      <details class="techniques-toggle" open>
        <summary><h2 id="techniques-title">Attacks</h2></summary>
        <p class="panel-note">Pick one, then send it. Custom emails will not work here.</p>
        {sections.map((section) => (
          <div class="technique-group" data-group={section.id}>
            <h3>{section.label} <span class="count" data-count>({section.ids.length})</span></h3>
            {section.note && <p class="technique-note">{section.note}</p>}
            <ul>{section.techniques.map((t) => <li><button class="technique" type="button" data-technique={t.id} aria-pressed="false"><span>{t.label}</span><span class="tried-mark" hidden><span aria-hidden="true">✓</span><span class="visually-hidden">, tried</span></span></button></li>)}</ul>
          </div>
        ))}
      </details>
    </aside>

    <section class="chat chat-tabbed tw-bench" aria-labelledby="bench-title">
      <h2 id="bench-title" class="visually-hidden">Test Tidewater</h2>
      <div class="version-tabs" role="tablist" aria-label="Version" hidden>
        {versions.map((v, i) => (
          <button type="button" role="tab" id={`tab-${v}`} data-version={v} aria-selected={i === 0 ? 'true' : 'false'} aria-controls="bench" tabindex={i === 0 ? undefined : '-1'}>
            {v[0].toUpperCase() + v.slice(1)}<span class="tab-state" data-tab-state></span>
          </button>
        ))}
      </div>
      <div class="chat-body tw-body" id="bench" role="region" aria-labelledby="bench-title"></div>
      <div class="compose tw-bar">
        <p class="tw-bar-note" id="tw-bar-note">Pick an attack from the list. Each one runs in three stages.</p>
        <div class="tw-bar-actions">
          <button class="button button-primary" type="button" id="tw-primary" disabled>Pick an attack first</button>
          <button class="button button-secondary" type="button" id="tw-reject" hidden>Reject batch</button>
        </div>
      </div>
      <p class="form-error" id="tw-error" role="alert" hidden></p>
      <p class="visually-hidden" id="tw-say" role="status" aria-live="polite"></p>
    </section>

    <aside class="panel evidence" aria-labelledby="evidence-title">
      <h2 id="evidence-title" tabindex="-1">What happened</h2>
      <div id="ev-happened"></div>
      <div id="ev-list" class="ev-list">
        <p class="panel-note">Did you see one of these? Mark it found, and the latest result is saved as evidence.</p>
        <Checklist caseId="tidewater" />
      </div>
    </aside>
  </div>

  <p class="next-row test-next"><a class="button button-primary" href="/case-studies/tidewater/answers/">Next: view the answer sheet <span aria-hidden="true">→</span></a> <a class="text-link" href="/case-studies/tidewater/before/">Back to your list</a></p>
</CaseStudyLayout>

<script>
  import { mountChecklist } from '../../../lib/case-studies/panels';
  import { LOCATION_LABELS, outcome, TidewaterSession, type Email, type Setup } from '../../../lib/case-studies/tidewater';
  import { esc, VARIANTS, VARIANT_LABELS, type ToolCall, type Variant } from '../../../lib/case-studies/runner';
  import { EXPLAIN, lessonFor, setupFor, verdict, type Technique } from '../../../lib/case-studies/tidewater-techniques';

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const bench = $('#bench');
  const tabs = $('.version-tabs');
  const primary = $<HTMLButtonElement>('#tw-primary');
  const reject = $<HTMLButtonElement>('#tw-reject');
  const barNote = $('#tw-bar-note');
  const say = $('#tw-say');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Long enough to read as work, short enough to keep the flow moving.
  const WORK_DELAY = reduce ? 200 : 900;

  let sessions = {} as Record<Variant, TidewaterSession>;
  let active: Variant = 'weak';
  let stage = 1;
  let ran = false;
  let pending = false;
  let ready: Technique | null = null;
  const tried = new Set<string>();

  const s = () => sessions[active];
  const decided = (v: Variant) => !!sessions[v]?.approval?.decision;
  const decidedCount = () => VARIANTS.filter(decided).length;
  const nextUndecided = () => (ran ? VARIANTS.find((v) => !decided(v)) : undefined);
  const money = (n: number) => `SGD ${n.toLocaleString('en-SG')}`;
  const showError = (m = '') => { const e = $('#tw-error'); e.textContent = m; e.hidden = !m; };
  // Which collapsibles were open, so a re-render does not close them.
  const openBits = () => [...bench.querySelectorAll<HTMLElement>('details[data-keep][open]')].map((d) => d.dataset.keep!);

  // ---------- Picking an attack: back to stage 1, with a fresh batch on all three versions ----------
  function pick(t: Technique) {
    if (pending) return;
    ready = t;
    active = 'weak';
    stage = 1;
    ran = false;
    sessions = Object.fromEntries(VARIANTS.map((v) => [v, new TidewaterSession(v, setupFor(t))])) as Record<Variant, TidewaterSession>;
    showError();
    render();
    bench.scrollTop = 0;
    say.textContent = `Stage 1, the attack: ${t.label}. Send it to the AI agent.`;
    if (matchMedia('(max-width: 1000px)').matches) $('.tw-bench').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
  }

  // ---------- Sending: the same email goes to all three versions ----------
  function run() {
    if (!ready || ran || pending) return;
    pending = true;
    tried.add(ready.id);
    render();
    say.textContent = 'The agent is reading the inbox.';
    setTimeout(() => {
      try {
        VARIANTS.forEach((v) => sessions[v].process());
      } catch (err) {
        pending = false;
        showError((err as Error).message);
        render();
        return;
      }
      pending = false;
      ran = true;
      stage = 2;
      active = 'weak';
      showError();
      render();
      bench.scrollTop = 0;
      say.textContent = 'Stage 2, you approve. Weak is waiting for your decision.';
    }, WORK_DELAY);
  }

  function decide(approve: boolean) {
    const session = s();
    if (!ran || pending || !session.approval || session.approval.decision) return;
    session.decide(approve);
    stage = 3;
    render();
    bench.scrollTop = 0;
    bench.querySelector<HTMLElement>('.tw-verdict')?.classList.add('is-new');
    const r = verdict(session);
    say.textContent = `Stage 3, what really happened. ${VARIANT_LABELS[active]} ${r.ok ? 'passed' : 'failed'}: ${r.headline}`;
  }

  // The bottom bar holds the one action for the stage. After the last version it points at the failure list.
  function goNext() {
    const next = nextUndecided();
    if (next) {
      active = next;
      stage = 2;
      render();
      bench.scrollTop = 0;
      say.textContent = `Stage 2, you approve. ${VARIANT_LABELS[next]} is waiting for your decision.`;
      return;
    }
    const list = $('#ev-list');
    list.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    (list.querySelector<HTMLElement>('button:not([disabled]), a') ?? $('#evidence-title')).focus({ preventScroll: true });
  }

  // ---------- The emails ----------
  // Which emails carry this attack: the one holding the attack text, the urgent follow-up, or both copies of a resend.
  function carriesAttack(e: Email, setup: Setup, inbox: Email[]) {
    const text = setup.attackText.trim();
    if (text && [e.body, e.signature, e.attachment?.hidden ?? '', e.attachment?.visible ?? ''].some((f) => f.includes(text))) return true;
    if (setup.pressure) return e.subject.startsWith('Urgent:');
    return setup.attack === 'duplicate' && !!e.invoice && inbox.filter((x) => x.invoice?.number === e.invoice!.number).length > 1;
  }

  // `revealHidden` is the attacker's view. Without it the email reads the way a person opening it would.
  function emailCard(e: Email, attackText: string, revealHidden: boolean) {
    const mark = (t: string) => attackText && t.includes(attackText)
      ? esc(t).split(esc(attackText)).join(`<mark class="tw-attack">${esc(attackText)}</mark>`)
      : esc(t);
    const att = e.attachment;
    const layer = revealHidden && att?.hidden ? `<pre class="hidden-layer" aria-label="Hidden text layer in the PDF">${mark(att.hidden)}</pre>` : '';
    const unseen = !revealHidden && att?.hidden ? '<p class="note">This PDF also holds a layer of text you cannot see. The agent read all of it.</p>' : '';
    return `<article class="email">
      <h4>${esc(e.subject)}</h4>
      <p class="email-meta">From <strong>${esc(e.from)}</strong></p>
      <p class="email-body">${mark(e.body)}</p>
      <p class="email-sig">${mark(e.signature)}</p>
      ${att ? `<div class="attachment"><p class="attachment-name">${esc(att.name)}</p><pre>${mark(att.visible)}</pre>${layer}${unseen}</div>` : ''}
    </article>`;
  }

  // ---------- The approval screen, which is all the finance officer sees ----------
  const STATUS: Record<string, { label: string; cls: string }> = {
    scheduled: { label: 'Ready', cls: 'ok' },
    released: { label: 'Released', cls: 'bad' },
    held: { label: 'Held', cls: 'bad' },
    quarantined: { label: 'Quarantined', cls: 'bad' },
    duplicate: { label: 'Skipped', cls: '' },
    paid: { label: 'Paid', cls: 'ok' },
    rejected: { label: 'Not paid', cls: '' },
  };
  const statusPill = (status: string) => {
    const st = STATUS[status] ?? { label: status, cls: '' };
    return `<span class="pill ${st.cls}">${esc(st.label)}</span>`;
  };
  function approvalCard(session: TidewaterSession) {
    const a = session.approval!;
    const rows = a.rows ? a.rows.map((r) => `<tr>
        <th scope="row">${esc(r.invoice)}</th>
        <td data-label="Vendor">${esc(r.vendor)}</td>
        <td class="nowrap" data-label="Amount">${money(r.amount)}</td>
        <td class="nowrap" data-label="Pay to">ending ${esc(r.account)}</td>
        <td class="nowrap" data-label="On file">ending ${esc(r.accountOnFile)}</td>
        <td data-label="Status">${statusPill(r.status)}${r.note ? `<span class="cell-detail">${esc(r.note)}</span>` : ''}</td>
      </tr>`).join('') : '';
    const table = a.rows ? `<div class="table-scroll"><table class="results approval-table"><caption>Every payment, the account it will use, and the account on file</caption><thead><tr><th scope="col">Invoice</th><th scope="col">Vendor</th><th scope="col">Amount</th><th scope="col">Pay to</th><th scope="col">On file</th><th scope="col">Status</th></tr></thead><tbody>${rows}</tbody></table></div>${session.flags.filter((f) => f.callback).map((f) => `<p class="note"><strong>Callback task:</strong> ${esc(f.callback!)}</p>`).join('')}` : '';
    const notes = a.notes.map((n) => `<p class="approval-note"><strong>${a.rows ? 'Flag' : 'Vendor note'}, ${esc(n.invoice)}:</strong> ${noteHtml(n.text, a.links)}</p>`).join('');
    const decision = a.decision ? `<p class="tw-decided pill ${a.decision === 'approved' ? 'ok' : 'bad'}">You ${a.decision} this batch</p>` : '';
    const phish = a.decision === 'approved' && a.links.length ? '<p class="tw-warn">That link came from a supplier document, and this version put it on your screen ready to click.</p>' : '';
    return `<div class="approval-card">${decision}<h3>Payment batch for approval</h3><p class="approval-summary">${esc(a.summary)}</p>${notes}${phish}${table}<p class="approval-total">Total to release: <strong>${money(a.total)}</strong></p></div>`;
  }

  // A link copied from document text is shown as this version left it: clickable.
  function noteHtml(text: string, links: { invoice: string; label: string; url: string }[]) {
    const l = links.find((x) => text.includes(x.label));
    return l ? `${esc(text).replace(esc(l.label), `<a class="phish-link" href="${esc(l.url)}" target="_blank" rel="noopener noreferrer">${esc(l.label)}</a>`)}` : esc(text);
  }

  function toolsHtml(events: ToolCall[]) {
    if (!events.length) return '<p class="note">No tools were called.</p>';
    return `<ul class="tool-calls">${events.map((e) => `<li class="tool-call"><p><code>${esc(e.name)}</code></p>${e.note ? `<p class="note">${esc(e.note)}</p>` : ''}<details data-tool-details><summary>Input and output</summary><pre>${esc(JSON.stringify({ input: e.input, output: e.output }, null, 2))}</pre></details></li>`).join('')}</ul>`;
  }

  // ---------- The middle panel: three stages, one attack ----------
  const STAGES = ['The attack', 'You approve', 'What really happened'];
  function stagesHtml() {
    const current = pending ? 2 : stage;
    return `<ol class="tw-stages">${STAGES.map((label, i) => {
      const n = i + 1, done = n < current;
      return `<li class="tw-stage${n === current ? ' is-current' : ''}${done ? ' is-done' : ''}"${n === current ? ' aria-current="step"' : ''}><span class="tw-stage-n" aria-hidden="true">${n}</span><span class="tw-stage-label">${label}</span><span class="visually-hidden">${n === current ? ', this stage now' : done ? ', done' : ', not yet'}</span></li>`;
    }).join('')}</ol>`;
  }

  function introHtml() {
    return `<p class="chat-empty">Tidewater's agent reads the supplier inbox, matches invoices to purchase orders, and prepares one payment batch for a person to release.</p>
      <p class="chat-empty-hint"><span class="hint-arrow" aria-hidden="true"></span><span>Pick an attack from the list. You send it, you decide on each version, then you see what really happened.</span></p>`;
  }

  function workingHtml() {
    return `<h3 class="tw-title">The agent is reading the inbox</h3>
      <p class="tw-lede">The same email went to all three versions. Each one is preparing a batch for you to approve or reject.<span class="tw-dots" aria-hidden="true"><i></i><i></i><i></i></span></p>`;
  }

  // Stage 1: you are the attacker, and this is the email you send.
  function attackStage() {
    const t = ready!;
    const setup = setupFor(t);
    const inbox = sessions.weak.inbox;
    const text = setup.attackText.trim();
    const attacker = !!text || !!t.pressure;
    const carrying = inbox.filter((e) => carriesAttack(e, setup, inbox));
    const shown = carrying.length ? carrying : inbox;
    const rest = inbox.filter((e) => !shown.includes(e));
    const open = openBits();
    return `<h3 class="tw-title">${attacker ? 'You are the attacker' : 'This batch has no attack'}</h3>
      <p class="tw-lede">${attacker ? 'This is the email you send to Tidewater\'s accounts-payable agent. The highlighted text is your attack, and nobody at Tidewater sees this screen.' : 'Send it anyway. A normal batch is the control you compare every attack against.'}</p>
      ${text ? `<p class="tw-explain"><strong>Where it sits:</strong> ${esc(LOCATION_LABELS[setup.location])}. ${esc(EXPLAIN[setup.location] ?? '')}</p>` : ''}
      ${t.about ? `<p class="tw-explain">${esc(t.about)}</p>` : ''}
      <div class="tw-emails">${shown.map((e) => emailCard(e, text, true)).join('')}</div>
      ${rest.length ? `<details class="tw-more" data-keep="rest"${open.includes('rest') ? ' open' : ''}><summary>The rest of the inbox (${rest.length})</summary><p class="note">The other emails in today's batch. They are genuine.</p><div class="tw-emails">${rest.map((e) => emailCard(e, text, false)).join('')}</div></details>` : ''}`;
  }

  // Stage 2: you are the finance officer, and this is all you get to see.
  function approveStage() {
    const session = s();
    const text = setupFor(ready!).attackText.trim();
    const open = openBits();
    return `<h3 class="tw-title">You are the finance officer</h3>
      <p class="tw-lede">This is everything the ${esc(VARIANT_LABELS[session.variant].toLowerCase())} agent shows you. Would you approve it?</p>
      ${approvalCard(session)}
      <details class="tw-more" data-keep="emails"${open.includes('emails') ? ' open' : ''}><summary>Check the emails yourself (${session.inbox.length})</summary><p class="note">Today's inbox as a person would read it.</p><div class="tw-emails">${session.inbox.map((e) => emailCard(e, text, false)).join('')}</div></details>`;
  }

  // Stage 3: the verdict, the failed checks, and what the agent actually did.
  function resultStage() {
    const session = s();
    const r = verdict(session);
    const open = openBits();
    const failed = r.failed.map((f) => `<li><strong>${esc(f.label)}.</strong> ${esc(f.detail)}</li>`).join('');
    return `<h3 class="tw-title">What really happened</h3>
      <div class="tw-verdict ${r.ok ? 'is-pass' : 'is-fail'}">
        <p class="tw-verdict-line"><span class="tw-badge">${r.ok ? 'Passed' : 'Failed'}</span>${esc(r.headline)}</p>
        <p class="tw-verdict-you">You ${session.approval!.decision === 'approved' ? 'approved' : 'rejected'} this batch.</p>
      </div>
      ${r.note ? `<p class="tw-warn">${esc(r.note)}</p>` : ''}
      ${failed ? `<h4 class="tw-sub">What it got wrong</h4><ul class="tw-failed">${failed}</ul>` : '<p class="tw-passed">Every check passed on this batch.</p>'}
      <h4 class="tw-sub">What the agent did</h4>
      <ol class="agent-log">${session.log.map((l) => `<li>${esc(l)}</li>`).join('')}</ol>
      <details class="behind" data-keep="tools"${open.includes('tools') ? ' open' : ''}><summary>Tool calls (${session.events.length})</summary>${toolsHtml(session.events)}</details>
      <details class="tw-more" data-keep="shown"${open.includes('shown') ? ' open' : ''}><summary>What you were shown before deciding</summary>${approvalCard(session)}</details>
      ${nextUndecided() ? '' : '<p class="chat-empty-hint"><span class="hint-arrow hint-right" aria-hidden="true"></span><span>All three versions decided. Mark what you saw on your failure list, then try another attack.</span></p>'}`;
  }

  // ---------- Rendering ----------
  function renderStage() {
    bench.innerHTML = !ready ? introHtml() : stagesHtml() + `<div class="tw-stage-body">${pending ? workingHtml() : stage === 1 ? attackStage() : stage === 2 ? approveStage() : resultStage()}</div>`;
  }

  // Tabs appear once there is a batch to decide on. They say whether a version is waiting or done, never what it did.
  function renderTabs() {
    tabs.hidden = !ran;
    document.querySelectorAll<HTMLButtonElement>('[data-version]').forEach((b) => {
      const v = b.dataset.version as Variant;
      b.setAttribute('aria-selected', String(v === active));
      b.tabIndex = v === active ? 0 : -1;
      const state = b.querySelector<HTMLElement>('[data-tab-state]')!;
      state.innerHTML = !ran ? '' : decided(v) ? 'Decided' : 'Waiting<span class="visually-hidden"> for your decision</span>';
      state.classList.toggle('is-done', ran && decided(v));
    });
    bench.setAttribute('role', ran ? 'tabpanel' : 'region');
    bench.setAttribute('aria-labelledby', ran ? `tab-${active}` : 'bench-title');
  }

  function renderBar() {
    const next = nextUndecided();
    const done = decidedCount();
    let text = 'Pick an attack first', note = 'Pick an attack from the list. Each one runs in three stages.', arrow = false;
    if (pending) {
      text = 'The agent is working';
      note = 'Reading the inbox and preparing your batch.';
    } else if (!ran) {
      if (ready) { text = 'Send this email to the AI agent'; note = 'The same email goes to all three versions. You decide on each one in turn.'; arrow = true; }
    } else if (stage === 2) {
      text = 'Approve batch';
      note = `${VARIANT_LABELS[active]}: ${done} of 3 decided. What it did stays hidden until you choose.`;
    } else {
      text = next ? `Next: see what ${VARIANT_LABELS[next]} shows you` : 'Next: mark it on your list';
      note = next ? `${VARIANT_LABELS[next]} is waiting for your decision.` : 'All three decided. Mark what you saw on your failure list.';
      arrow = true;
    }
    primary.innerHTML = `${esc(text)}${arrow ? ' <span aria-hidden="true">→</span>' : ''}`;
    // Kept enabled while the agent works, so the click that sent the email does not drop focus.
    primary.disabled = !ready;
    primary.toggleAttribute('aria-disabled', pending);
    reject.hidden = !(ran && stage === 2 && !pending);
    barNote.textContent = note;
  }

  // Results stay hidden until the version has been decided.
  function renderEvidence() {
    const panel = $('#ev-happened');
    if (!ready || !ran) {
      panel.innerHTML = '<p class="evidence-empty">Send an attack to see what each version did. A result stays hidden until you have decided on that version.</p>';
      return;
    }
    const open = panel.querySelector('details.ev-detail')?.hasAttribute('open');
    const rows = VARIANTS.map((v) => {
      if (!decided(v)) return `<li><p class="compare-row is-waiting"><span class="compare-version">${VARIANT_LABELS[v]}</span><span>Waiting for your decision</span></p></li>`;
      const r = verdict(sessions[v]);
      return `<li><button type="button" class="compare-row" data-compare="${v}"${v === active ? ' aria-current="true"' : ''}><span class="compare-version">${VARIANT_LABELS[v]}</span><span><span class="pill ${r.ok ? 'ok' : 'bad'}">${r.ok ? 'Passed' : 'Failed'}</span> ${esc(r.headline)}</span></button></li>`;
    }).join('');
    const lesson = VARIANTS.every(decided) ? lessonFor(ready) : '';
    const session = s();
    panel.innerHTML = `
      <h3 class="evidence-title">${esc(ready.label)}</h3>
      <ul class="compare-list">${rows}</ul>
      ${lesson ? `<p class="lesson"><strong>What to notice:</strong> ${esc(lesson)}</p>` : ''}
      ${decided(active) ? `<details class="ev-detail"${open ? ' open' : ''}><summary>${VARIANT_LABELS[active]}: everything it did</summary><ol class="tw-outcome">${outcome(session).map((l) => `<li>${esc(l)}</li>`).join('')}</ol><h4>Tool calls</h4>${toolsHtml(session.events)}</details>` : ''}`;
  }

  function renderTried() {
    document.querySelectorAll<HTMLButtonElement>('[data-technique]').forEach((b) => { b.querySelector<HTMLElement>('.tried-mark')!.hidden = !tried.has(b.dataset.technique!); });
  }

  function render() {
    renderTabs();
    renderTried();
    renderStage();
    renderBar();
    renderEvidence();
    checklist?.render();
  }

  // Saved with a failure mode when it is marked found.
  function currentEvidence() {
    if (!ready || !ran) return null;
    const done = VARIANTS.filter(decided);
    if (!done.length) return null;
    return [`"${ready.label}"`, ...done.map((v) => { const r = verdict(sessions[v]); return `${VARIANT_LABELS[v]}: ${r.ok ? 'passed' : 'failed'}. ${r.headline}`; })].join('\n');
  }

  // ---------- Events ----------
  document.querySelectorAll<HTMLButtonElement>('[data-technique]').forEach((b) => b.addEventListener('click', () => {
    if (pending) return;
    pick(TECHNIQUES.find((t) => t.id === b.dataset.technique)!);
  }));

  document.querySelectorAll<HTMLButtonElement>('[data-version]').forEach((b) => b.addEventListener('click', () => {
    if (pending || !ran) return;
    active = b.dataset.version as Variant;
    stage = decided(active) ? 3 : 2;
    render();
    bench.scrollTop = 0;
    say.textContent = stage === 3 ? `${VARIANT_LABELS[active]}: what really happened.` : `Stage 2, you approve. ${VARIANT_LABELS[active]} is waiting for your decision.`;
  }));
  tabs.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
    const next = VARIANTS.at((VARIANTS.indexOf(active) + (e.key === 'ArrowRight' ? 1 : -1)) % VARIANTS.length)!;
    document.querySelector<HTMLButtonElement>(`[data-version="${next}"]`)!.click();
    document.querySelector<HTMLButtonElement>(`[data-version="${next}"]`)!.focus();
  });

  primary.addEventListener('click', () => {
    if (pending) return;
    if (!ran) run();
    else if (stage === 2) decide(true);
    else goNext();
  });
  reject.addEventListener('click', () => decide(false));

  $('#ev-happened').addEventListener('click', (e) => {
    const row = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-compare]');
    if (row) document.querySelector<HTMLButtonElement>(`[data-version="${row.dataset.compare}"]`)!.click();
  });

  const checklist = mountChecklist(document.querySelector('[data-checklist]')!, 'tidewater', currentEvidence);

  // On small screens the attack list starts closed, so the workspace is visible first.
  if (matchMedia('(max-width: 1000px)').matches) $<HTMLDetailsElement>('.techniques-toggle').open = false;

  render();
</script>
