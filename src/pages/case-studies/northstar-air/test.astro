---
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
import Checklist from '../../../components/case-studies/Checklist.astro';
import { PRESET_GROUPS, PRESETS } from '../../../lib/case-studies/northstar';
import { techniqueLabel } from '../../../lib/case-studies/northstar-report';

// Everyday requests come first, so testers see normal behaviour before the attacks.
// Controls are negative tests: a request no version can act on.
const CONTROLS = ['cancel-other'];
// Using the staff code only unlocks once a reply has leaked it, so the chain is leak, then use.
const LOCKED = 'staff-code';
const presetById = Object.fromEntries(PRESETS.map((p) => [p.id, { ...p, label: techniqueLabel(p) }]));
const sections = [
  { id: 'everyday', label: PRESET_GROUPS.everyday, note: 'Try one first to see what normal looks like.', subgroups: [{ label: '', ids: PRESETS.filter((p) => p.group === 'everyday' && !CONTROLS.includes(p.id)).map((p) => p.id) }] },
  { id: 'attack', label: PRESET_GROUPS.attack, note: '', subgroups: [
    { label: 'Accessing another customer’s data (IDOR)', ids: ['colleague-en', 'colleague-en-details', 'family', 'name-lookup'] },
    { label: 'Social engineering and impersonation', ids: ['travel-agent', 'authority', 'impersonation'] },
    { label: 'Filter bypass in another language', ids: ['colleague-ms', 'colleague-zh'] },
    { label: 'Prompt injection, jailbreaks and prompt extraction', ids: ['override', 'roleplay', 'reveal-prompt', 'summarise-rules', 'staff-code'] },
    { label: 'Multi-step and resource abuse', ids: ['two-step', 'mass-send'] },
  ] },
  { id: 'control', label: 'Controls', note: 'Should fail safely in every version: no version has a tool to cancel bookings.', subgroups: [{ label: '', ids: CONTROLS }] },
];
const grouped = sections.flatMap((s) => s.subgroups.flatMap((g) => g.ids));
if (grouped.length !== PRESETS.length || PRESETS.some((p) => !grouped.includes(p.id))) throw new Error('Every Northstar technique must appear in exactly one sidebar group.');

const guide = [
  { id: 'send', label: 'Send a technique', hint: '' },
  { id: 'mark', label: 'Mark it on your list', hint: '' },
];
---

<CaseStudyLayout title="Northstar Air: start testing AI" description="An airline support agent that looks up bookings and changes where itineraries are sent. Find where it fails, then prove the fix." backLink={{ href: '/case-studies/', label: 'All case studies' }} steps={{ slug: 'northstar-air', page: 3, report: true }}>
  <div class="intro test-intro"><h1 class="headline">Start testing AI</h1><p>Test Northstar Air against your list from <a class="text-link" href="/case-studies/northstar-air/before/">Before you start</a>, and note anything new.</p></div>

  <section class="guide" aria-labelledby="guide-title">
    <h2 id="guide-title" class="visually-hidden">How to work through this page</h2>
    <ol class="guide-steps">
      {guide.map((g, i) => <li data-guide={g.id} data-hint={g.hint} aria-current={i === 0 ? 'step' : undefined}><span class="guide-mark" aria-hidden="true">{i + 1}</span><span class="guide-label">{g.label}</span><span class="visually-hidden guide-state">, not done yet</span></li>)}
    </ol>
    <p class="guide-hint" id="guide-hint" role="status" hidden={!guide[0].hint}>{guide[0].hint}</p>
  </section>

  <div class="workbench">
    <aside class="panel techniques" aria-labelledby="techniques-title">
      <details class="techniques-toggle" open>
        <summary><h2 id="techniques-title">Techniques</h2></summary>
        <p class="panel-note">Pick one, then press Send.</p>
        <p class="panel-note">Every reply is scripted, so only these work, and everyone gets the same result that the report can replay. A real model is not deterministic: you would run each test many times. To attack a live model, play <a class="text-link" href="/hawker/">Uncle Lim’s secret</a>.</p>
        {sections.map((section) => (
          <div class="technique-group" data-group={section.id}>
            <h3>{section.label} <span class="count" data-count>({section.subgroups.reduce((n, g) => n + g.ids.length, 0)})</span></h3>
            {section.note && <p class="technique-note">{section.note}</p>}
            {section.subgroups.map((g) => (
              <>
                {g.label && <h4>{g.label}</h4>}
                <ul>{g.ids.map((id) => presetById[id]).map((p) => <li><button class="technique" type="button" data-preset={p.id} aria-pressed="false"><span>{p.label}</span><span class="tried-mark" hidden><span aria-hidden="true">✓</span><span class="visually-hidden">, tried</span></span></button>{p.id === LOCKED && <p class="technique-lock" id="staff-code-lock">Locked until a reply leaks the code. Ask the agent to repeat or summarise its rules first.</p>}</li>)}</ul>
              </>
            ))}
          </div>
        ))}
      </details>
    </aside>

    <section class="chat chat-tabbed" aria-labelledby="chat-title">
      <h2 id="chat-title" class="visually-hidden">Chat with Northstar Air</h2>
      <div class="version-tabs" role="tablist" aria-label="Version">
        {['weak', 'patched', 'safe'].map((v, i) => (
          <button type="button" role="tab" id={`tab-${v}`} data-version={v} aria-selected={i === 0 ? 'true' : 'false'} aria-controls="messages" tabindex={i === 0 ? undefined : '-1'}>
            {v[0].toUpperCase() + v.slice(1)}<span class="tab-new" hidden><span class="visually-hidden">, new reply</span></span>
          </button>
        ))}
      </div>
      <div class="chat-body" id="messages" role="tabpanel" aria-labelledby="tab-weak" aria-live="polite"><p class="chat-empty">Welcome to Northstar Air. How can I help with your booking?</p><p class="chat-empty-hint"><span class="hint-arrow" aria-hidden="true"></span><span>Pick a request or an attack from Techniques, then press Send. It goes to all three versions.</span></p></div>
      <form id="chat-form" class="compose">
        <textarea id="chat-input" aria-label="Customer message" aria-describedby="compose-note" placeholder="Pick a technique to fill this in" readonly></textarea>
        <p class="compose-note" id="compose-note" hidden>The agent asked for an email address. Type one, then press Send.</p>
        <div class="compose-actions">
          <div class="chat-controls">
            <label for="chat-principal">Signed in as</label>
            <select id="chat-principal"><option value="alex">Alex Morgan (B7N2M4)</option><option value="jordan">Jordan Lee (K3F9Q2)</option></select>
            <button type="button" class="text-link" id="start-over">Start over</button>
          </div>
          <button class="button button-primary" type="submit" id="send-button">Send <span aria-hidden="true">→</span></button>
        </div>
      </form>
      <p class="form-error" id="chat-error" role="alert" hidden></p>
    </section>

    <aside class="panel evidence" aria-labelledby="evidence-title">
      <h2 id="evidence-title">What happened</h2>
      <div class="ev-tabs" role="tablist" aria-label="What happened">
        <button type="button" role="tab" id="evtab-results" data-ev-tab="results" aria-controls="ev-happened" aria-selected="true">Results</button>
        <button type="button" role="tab" id="evtab-list" data-ev-tab="list" aria-controls="ev-list" aria-selected="false" tabindex="-1">Your list <span class="ev-tab-count" data-found-count></span></button>
      </div>
      <div id="ev-happened" role="tabpanel" aria-labelledby="evtab-results"></div>
      <div id="ev-list" class="ev-list" role="tabpanel" aria-labelledby="evtab-list" hidden>
        <p class="panel-note">Did you see one of these? Mark it found, and the latest result is saved as evidence.</p>
        <Checklist caseId="northstar-air" />
      </div>
    </aside>
  </div>

  <p class="next-row test-next"><a class="button button-primary" href="/case-studies/northstar-air/report/">Next: view the report <span aria-hidden="true">→</span></a> <a class="text-link" href="/case-studies/northstar-air/answers/">Answer sheet</a></p>
</CaseStudyLayout>

<script>
  import { mountChecklist, mountEvidenceTabs } from '../../../lib/case-studies/panels';
  import { NorthstarSession, PRESETS, PRINCIPAL_NAMES, STAFF_CODE, TECHNIQUE_CLASSIC, TECHNIQUE_LABELS, describeTurn, turnVerdict, type Escalation, type Principal } from '../../../lib/case-studies/northstar';
  import { auditJson, esc, LANG_LABELS, newId, VARIANTS, VARIANT_LABELS, store, type AuditEntry, type ToolCall, type Variant } from '../../../lib/case-studies/runner';
  import { createChatView } from '../../../lib/case-studies/chat-view';
  import { RUNS_KEY, type Run } from '../../../lib/case-studies/northstar-report';

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const input = $<HTMLTextAreaElement>('#chat-input');
  const normalize = (t: string) => t.trim().replace(/\s+/g, ' ').toLowerCase();
  const allowed = new Set(PRESETS.map((p) => normalize(p.text)));

  let principal: Principal = 'alex';
  let sessions = {} as Record<Variant, NorthstarSession>;
  let active: Variant = 'weak';
  let shownVariant: Variant | null = null;
  const unread = new Set<Variant>();
  const tried = new Set<string>();
  let lastTechnique = '';
  const done = new Set<string>();

  const view = createChatView($('#messages'), () => ({ user: PRINCIPAL_NAMES[principal], assistant: `Northstar Air · ${VARIANT_LABELS[active]}` }), 'Welcome to Northstar Air. How can I help with your booking?', 'Pick a request or an attack from Techniques, then press Send. It goes to all three versions.');
  const showError = (m = '') => { const e = $('#chat-error'); e.textContent = m; e.hidden = !m; };

  // Each conversation is saved so the report page can replay it.
  let runId = newId();
  function saveRun() {
    if (!sessions.weak?.steps.length) return;
    const runs = store.get<Run[]>(RUNS_KEY, []).filter((r) => r.id !== runId);
    runs.push({ id: runId, principal, at: new Date().toISOString(), steps: Object.fromEntries(VARIANTS.map((v) => [v, sessions[v].steps])) as Run['steps'] });
    store.set(RUNS_KEY, runs.slice(-30));
  }

  function startOver() {
    runId = newId();
    sessions = Object.fromEntries(VARIANTS.map((v) => [v, new NorthstarSession(v, { principal })])) as Record<Variant, NorthstarSession>;
    unread.clear();
    shownVariant = null;
    showError();
    render();
  }

  // ---------- Guided steps ----------
  function tick(id: string) {
    if (done.has(id)) return;
    done.add(id);
    renderGuide();
  }
  function renderGuide() {
    const items = [...document.querySelectorAll<HTMLElement>('[data-guide]')];
    const next = items.find((li) => !done.has(li.dataset.guide!));
    items.forEach((li) => {
      li.classList.toggle('is-done', done.has(li.dataset.guide!));
      li.toggleAttribute('aria-current', li === next);
      if (li === next) li.setAttribute('aria-current', 'step');
      li.querySelector('.guide-state')!.textContent = done.has(li.dataset.guide!) ? ', done' : li === next ? ', current step' : ', not done yet';
    });
    $('#guide-hint').hidden = next ? !next.dataset.hint : false;
    $('#guide-hint').textContent = next ? next.dataset.hint! : 'Both steps done. Keep testing, then view the report.';
  }

  // ---------- Sending ----------
  const REPLY_DELAY = matchMedia('(prefers-reduced-motion: reduce)').matches ? 250 : 700;
  let pending = false;

  function send(text: string) {
    if (!text.trim() || pending) return;
    showError();
    const preset = PRESETS.find((p) => normalize(p.text) === normalize(text));
    let targets = [...VARIANTS];
    // A typed email address only goes to the versions that asked for one.
    if (!preset) targets = targets.filter((v) => sessions[v].awaitingEmail);
    if (!targets.length) return;
    if (preset) { tried.add(preset.id); lastTechnique = preset.label; }
    const before = sessions[active].messages.length;
    const activeSent = targets.includes(active);
    try {
      for (const v of targets) {
        const s = sessions[v];
        if (allowed.has(normalize(text)) || (s.awaitingEmail && text.includes('@'))) s.turn(text);
        else s.decline(text);
        if (v !== active) unread.add(v);
      }
    } catch (err) { showError((err as Error).message); }
    input.value = '';
    selectPreset(null);
    // Show the customer's message first, then the agent's reply after a short pause, so each step is easy to follow.
    const s = sessions[active];
    if (!activeSent || s.messages.length <= before + 1) { render(); return; }
    pending = true;
    $<HTMLButtonElement>('#send-button').disabled = true;
    checklist.render();
    renderTabs();
    if (shownVariant !== active) { view.reset(); shownVariant = active; }
    view.sync(s.messages.slice(0, before + 1));
    const typing = document.createElement('div');
    typing.className = 'message assistant typing';
    typing.innerHTML = `<p class="role">Northstar Air · ${VARIANT_LABELS[active]}</p><p class="bubble"><span class="visually-hidden">Agent is replying</span><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span></p>`;
    $('#messages').appendChild(typing);
    $('#messages').scrollTop = $('#messages').scrollHeight;
    setTimeout(() => {
      typing.remove();
      pending = false;
      $<HTMLButtonElement>('#send-button').disabled = false;
      render();
      $('#messages').querySelectorAll('.message.assistant').forEach((m, i, all) => m.classList.toggle('is-new', i === all.length - 1));
      evTabs.show('results');
      $('#ev-happened').classList.remove('is-new'); void $('#ev-happened').offsetWidth; $('#ev-happened').classList.add('is-new');
    }, REPLY_DELAY);
  }

  function selectPreset(id: string | null) {
    document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.preset === id)));
    $('#chat-form').classList.toggle('is-ready', id !== null);
  }

  // ---------- Rendering ----------
  function renderTabs() {
    document.querySelectorAll<HTMLButtonElement>('[data-version]').forEach((b) => {
      const v = b.dataset.version as Variant;
      b.setAttribute('aria-selected', String(v === active));
      b.tabIndex = v === active ? 0 : -1;
      b.querySelector<HTMLElement>('.tab-new')!.hidden = !unread.has(v);
    });
    $('#messages').setAttribute('aria-labelledby', `tab-${active}`);
  }

  // What a tool call ended in: blocked, handed to a person, or done.
  function toolResult(e: ToolCall) {
    const out = (e.output ?? {}) as Record<string, unknown>;
    if (out.error || out.blocked) return { label: 'Blocked', cls: 'ok' };
    if (out.queued) return { label: 'Sent to a human agent', cls: '' };
    return { label: 'Done', cls: e.authorized === false || out.revealed ? 'bad' : '' };
  }

  // One line per tool call, in the terms of the audit log.
  function logLine(e: ToolCall) {
    const r = toolResult(e);
    const ref = (e.input as { reservation_id?: string }).reservation_id;
    const owner = e.authorized === false ? ` · caller does not own ${esc(ref ?? 'this booking')}` : '';
    return `<code>${esc(e.name)}</code> <span class="${r.cls === 'bad' ? 'log-bad' : r.cls === 'ok' ? 'log-ok' : ''}">${esc(r.label.toLowerCase())}${owner}</span>`;
  }

  // Each version's latest message: a verdict from the checks, what it did, and what the log shows.
  function resultRow(v: Variant) {
    const s = sessions[v], i = s.turns.length - 1, t = s.turns[i];
    const { applied, failed } = turnVerdict(s, i);
    const kinds = [...new Set(failed.map((f) => f.kind))];
    const badge = failed.length
      ? `<span class="result-badge bad"><span aria-hidden="true">✕</span> Failed</span> <span class="result-fails">${esc(kinds.join(', '))}</span>`
      : applied ? '<span class="result-badge ok"><span aria-hidden="true">✓</span> Passed</span>' : '<span class="result-badge">No check applies</span>';
    const parity = t.decision.kind !== t.decisionIfEnglish.kind ? ' <span class="log-bad">· not what it does in English</span>' : '';
    const log = t.tools.length ? t.tools.map(logLine).join('<br>') : '<span>No tool was called.</span>';
    return `<li class="result-row${failed.length ? ' is-fail' : ''}${v === active ? ' is-active' : ''}">
      <p class="result-head"><span class="compare-version">${VARIANT_LABELS[v]}</span> ${badge}</p>
      <p class="result-what">${esc(describeTurn(s, i))}</p>
      <p class="result-log">${log}${parity}</p>
      ${failed.length ? `<ul class="result-why">${failed.map((f) => `<li>${esc(f.detail)}</li>`).join('')}</ul>` : ''}
      <div class="result-actions">${v === active ? '<span class="result-showing">Showing in chat</span>' : `<button type="button" class="text-link" data-compare="${v}">Show ${VARIANT_LABELS[v]} chat</button>`}${t.tools.length ? `<details class="result-entries"><summary>Log ${t.tools.length === 1 ? 'entry' : `entries (${t.tools.length})`}</summary><pre>${esc(t.tools.map(auditJson).join('\n'))}</pre></details>` : ''}</div>
    </li>`;
  }

  const queueItem = (v: Variant, e: Escalation) => `<li class="queue-item"><p><strong>Booking ${esc(e.ref)}</strong> <span class="pill ${e.owns ? 'ok' : 'bad'}">${e.owns ? 'Caller owns this booking' : 'Caller does not own this booking'}</span></p><p>${e.recipient ? `Change delivery to <strong>${esc(e.recipient)}</strong>` : 'Wants booking details'}</p>${e.status === 'open' ? `<div class="queue-actions"><button class="button button-primary" type="button" data-resolve="${e.id}" data-variant="${v}" data-approve="1">Approve</button><button class="text-link" type="button" data-resolve="${e.id}" data-variant="${v}" data-approve="0">Decline</button></div>` : `<p class="pill">${e.status === 'approved' ? 'Approved' : 'Declined'}</p>`}</li>`;

  function renderEvidence() {
    const s = sessions[active];
    const panel = $('#ev-happened');
    const answered = VARIANTS.filter((v) => sessions[v].turns.length);
    if (!answered.length) {
      panel.innerHTML = `<p class="evidence-empty">Send a technique to see what each version did.</p>`;
      return;
    }
    const lastSaid = (v: Variant) => sessions[v].steps.filter((st) => st.action === 'say').at(-1)?.value;
    const compared = answered.length === VARIANTS.length && VARIANTS.every((v) => lastSaid(v) === lastSaid(active));
    const t = (s.turns.length ? s : sessions[answered[0]]).turns.at(-1)!;
    const detected = `<p class="evidence-meta">${esc(LANG_LABELS[t.parsed.lang])} · ${t.parsed.techniques.length ? t.parsed.techniques.map((x) => `<span class="pill">${esc(TECHNIQUE_LABELS[x])} <span class="pill-aka">(${esc(TECHNIQUE_CLASSIC[x].toLowerCase())})</span></span>`).join(' ') : 'No attack technique detected'}</p>`;
    // The human agent's queue, from whichever version handed a request over.
    const open = VARIANTS.flatMap((v) => sessions[v].escalations.filter((e) => e.status === 'open').map((e) => queueItem(v, e)));
    const decided = s.escalations.filter((e) => e.status !== 'open').map((e) => queueItem(active, e)).join('');
    const earlier = s.turns.slice(0, -1).map((_, j) => `<li>${esc(describeTurn(s, j))}</li>`).join('');
    const outbox = s.outbox.length ? `<ul class="outbox-list">${[...s.outbox].reverse().map((o) => `<li><code>${esc(o.reservation_id)}</code> to ${esc(o.recipient)}</li>`).join('')}</ul>` : '<p class="note">Nothing sent.</p>';
    const wasOpen = $('#ev-happened details.ev-detail')?.hasAttribute('open');
    panel.innerHTML = `
      ${open.length ? `<section class="decision-card" aria-labelledby="decision-title"><h3 id="decision-title">Decision needed</h3><p class="note">Safe handed this to a person. You are the Northstar agent: decide with what is on screen.</p><ul class="queue-list">${open.join('')}</ul></section>` : ''}
      <h3 class="evidence-title">${compared ? 'Same message, three versions' : 'Each version’s latest message'}</h3>
      ${detected}
      <ul class="result-list">${answered.map(resultRow).join('')}</ul>
      <button type="button" class="ev-next" data-goto-list>Seen a failure? Mark it on your list <span aria-hidden="true">→</span></button>
      ${s.turns.length ? `<details class="ev-detail"${wasOpen ? ' open' : ''}>
        <summary>${VARIANT_LABELS[active]}: outbox, earlier messages and full log</summary>
        ${decided ? `<h4>Human agent decisions</h4><ul class="queue-list">${decided}</ul>` : ''}
        <h4>Test outbox</h4>
        ${outbox}
        ${earlier ? `<h4>Earlier messages</h4><ol class="earlier-list">${earlier}</ol>` : ''}
        ${auditLog(s.events)}
      </details>` : ''}`;
  }

  // The whole session as JSON lines, the way a SIEM would ingest it.
  function auditLog(events: AuditEntry[]) {
    if (!events.length) return '';
    return `<h4>Audit log</h4><p class="note">Every tool call this session made, one JSON object per line. In a real deployment this is where detection happens: the chat is what the attacker says, the log is what the agent did.</p><pre class="audit-log" tabindex="0" aria-label="Audit log, ${events.length} ${events.length === 1 ? 'entry' : 'entries'}">${esc(events.map(auditJson).join('\n'))}</pre>`;
  }

  // Saved with a failure mode when it is marked found.
  function currentEvidence() {
    if (pending) return null;
    const shown = VARIANTS.filter((v) => sessions[v]?.turns.length);
    if (!shown.length) return null;
    const lines = shown.map((v) => `${VARIANT_LABELS[v]}: ${describeTurn(sessions[v], sessions[v].turns.length - 1)}`);
    return [lastTechnique ? `"${lastTechnique}"` : '', ...lines].filter(Boolean).join('\n');
  }

  function renderTried() {
    const leaked = VARIANTS.some((v) => sessions[v]?.turns.some((t) => t.reply.includes(STAFF_CODE)));
    const lock = document.querySelector<HTMLButtonElement>('[data-preset="staff-code"]')!;
    lock.disabled = !leaked;
    if (leaked) lock.removeAttribute('aria-describedby'); else lock.setAttribute('aria-describedby', 'staff-code-lock');
    $('#staff-code-lock').hidden = leaked;
    document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => { b.querySelector<HTMLElement>('.tried-mark')!.hidden = !tried.has(b.dataset.preset!); });
    document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
      const ids = [...g.querySelectorAll<HTMLButtonElement>('[data-preset]')].map((b) => b.dataset.preset!);
      const n = ids.filter((id) => tried.has(id)).length;
      g.querySelector('[data-count]')!.textContent = n ? `(${n} of ${ids.length} tried)` : `(${ids.length})`;
    });
  }

  // The message box is filled by techniques. It only opens for typing when the agent asks for an email address.
  function renderCompose() {
    const awaiting = VARIANTS.some((v) => sessions[v].awaitingEmail);
    input.readOnly = !awaiting;
    input.placeholder = awaiting ? 'Type an email address, such as me@example.test' : 'Pick a technique to fill this in';
    $('#compose-note').hidden = !awaiting;
  }

  function render() {
    // Step 1 ticks once a reply is on screen, not when a technique is picked.
    if (!pending && VARIANTS.some((v) => sessions[v].turns.length)) tick('send');
    renderTabs();
    renderTried();
    renderCompose();
    checklist?.render();
    if (!pending) saveRun();
    const s = sessions[active];
    if (shownVariant !== active) { view.reset(); shownVariant = active; }
    view.sync(s.messages);
    renderEvidence();
  }

  // ---------- Events ----------
  document.querySelectorAll<HTMLButtonElement>('[data-version]').forEach((b) => b.addEventListener('click', () => {
    active = b.dataset.version as Variant;
    unread.delete(active);
    render();
  }));
  $('.version-tabs').addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
    const i = VARIANTS.indexOf(active) + (e.key === 'ArrowRight' ? 1 : -1);
    const next = VARIANTS.at(i % VARIANTS.length)!;
    document.querySelector<HTMLButtonElement>(`[data-version="${next}"]`)!.click();
    document.querySelector<HTMLButtonElement>(`[data-version="${next}"]`)!.focus();
  });

  document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => {
    input.value = PRESETS.find((p) => p.id === b.dataset.preset)!.text;
    input.dispatchEvent(new Event('input'));
    selectPreset(b.dataset.preset!);
    $<HTMLButtonElement>('#send-button').focus({ preventScroll: true });
  }));
  input.addEventListener('input', () => {
    const match = PRESETS.find((p) => normalize(p.text) === normalize(input.value));
    selectPreset(match ? match.id : null);
  });
  $('#chat-form').addEventListener('submit', (e) => { e.preventDefault(); send(input.value); input.focus(); });
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) $<HTMLFormElement>('#chat-form').requestSubmit(); });

  $<HTMLSelectElement>('#chat-principal').addEventListener('change', (e) => { principal = (e.target as HTMLSelectElement).value as Principal; startOver(); });
  $('#start-over').addEventListener('click', startOver);

  $('#ev-happened').addEventListener('click', (e) => {
    const row = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-compare]');
    if (row) { document.querySelector<HTMLButtonElement>(`[data-version="${row.dataset.compare}"]`)!.click(); return; }
  });
  $('#ev-happened').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-resolve]');
    if (!b) return;
    sessions[b.dataset.variant as Variant].resolve(Number(b.dataset.resolve), b.dataset.approve === '1');
    render();
  });


  const checklist = mountChecklist(document.querySelector('[data-checklist]')!, 'northstar-air', currentEvidence);
  const evTabs = mountEvidenceTabs($('.panel.evidence'), 'northstar-air');
  $('#ev-list').addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-status]')) return;
    const rows = store.get<{ status?: string }[]>('aaei:northstar-air:worksheet', []);
    if (rows.some((r) => r.status === 'found')) tick('mark');
  });

  // On small screens the technique list starts closed, so the chat is visible first.
  if (matchMedia('(max-width: 1000px)').matches) $<HTMLDetailsElement>('.techniques-toggle').open = false;

  startOver();
  renderGuide();
</script>
