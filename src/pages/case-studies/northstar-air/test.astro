---
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
import Checklist from '../../../components/case-studies/Checklist.astro';
import { PRESET_GROUPS, PRESETS } from '../../../lib/case-studies/northstar';
---

<CaseStudyLayout title="Northstar Air: start testing AI" description="An airline support agent that looks up bookings and changes where itineraries are sent. Find where it fails, then prove the fix." backLink={{ href: '/case-studies/', label: 'All case studies' }} steps={{ slug: 'northstar-air', page: 3 }}>
  <div class="intro test-intro"><h1 class="headline">Start testing AI</h1><p>Test Northstar Air against your list from <a class="text-link" href="/case-studies/northstar-air/before/">Before you start</a>, and note anything you find that is not on it.</p></div>

  <section id="start-testing" aria-label="Test the AI">
    <div class="chat-layout">
      <aside class="setup">
        <form id="setup-form">
          <h2>Start a session</h2>
          <div class="field"><label for="chat-variant">Version</label><select id="chat-variant"><option value="weak">Weak</option><option value="patched">Patched</option><option value="safe">Safe</option></select></div>
          <div class="field"><label for="chat-principal">Signed in as</label><select id="chat-principal"><option value="alex">Alex Morgan (owns B7N2M4)</option><option value="jordan">Jordan Lee (owns K3F9Q2)</option></select></div>
          <button class="button button-primary" type="submit">Start fresh session <span aria-hidden="true">→</span></button>
        </form>
        <div class="presets">
          <h2>Technique library</h2>
          <p>Fills the message box, and starts a session if you haven't. The agent only understands these examples; anything else gets a polite refusal.</p>
          {Object.entries(PRESET_GROUPS).map(([group, label]) => (
            <Fragment><h3 class="preset-group">{label}</h3>{PRESETS.filter((p) => p.group === group).map((p) => <button class="text-link" type="button" data-preset={p.id}>{p.label} <span aria-hidden="true">→</span></button>)}</Fragment>
          ))}
        </div>
      </aside>
      <div class="test-main">
        <section class="chat" aria-labelledby="chat-title">
          <div class="chat-head"><h2 id="chat-title">Northstar Air</h2><p id="session-label">No session yet</p></div>
          <div class="chat-body" id="messages" aria-live="polite"><p class="chat-empty">Welcome to Northstar Air. How can I help with your booking?</p></div>
          <form id="chat-form" class="compose"><textarea id="chat-input" aria-label="Customer message" placeholder="Start a session to chat" disabled></textarea><button class="button button-primary" type="submit" disabled>Send <span aria-hidden="true">→</span></button></form>
          <p class="form-error" id="chat-error" role="alert" hidden></p>
        </section>
        <Checklist caseId="northstar-air" />
      </div>
    </div>

    <section class="queue" id="queue" aria-labelledby="queue-title" hidden>
      <h2 id="queue-title">Human agent queue</h2>
      <p>You are the Northstar agent. Decide each request with what's on this screen.</p>
      <ul id="queue-list"></ul>
    </section>

    <details class="behind" id="behind" hidden><summary>What happened behind the scenes</summary><div id="behind-body"></div></details>
  </section>

  <p class="answers-link"><a class="text-link" href="/case-studies/northstar-air/answers/">Answer sheet: how each version behaves in every scenario <span aria-hidden="true">→</span></a></p>
</CaseStudyLayout>

<script>
  import { mountChecklist } from '../../../lib/case-studies/panels';
  import { NorthstarSession, PRESETS, PRINCIPAL_NAMES, TECHNIQUE_LABELS, type Principal } from '../../../lib/case-studies/northstar';
  import { esc, LANG_LABELS, VARIANT_LABELS, type Variant } from '../../../lib/case-studies/runner';
  import { createChatView } from '../../../lib/case-studies/chat-view';

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const input = $<HTMLTextAreaElement>('#chat-input');
  const send = $<HTMLButtonElement>('#chat-form button');
  let chat: NorthstarSession | null = null;
  const normalize = (t: string) => t.trim().replace(/\s+/g, ' ').toLowerCase();
  const allowed = new Set(PRESETS.map((p) => normalize(p.text)));
  const view = createChatView($('#messages'), () => ({ user: chat ? PRINCIPAL_NAMES[chat.principal] : 'You', assistant: 'Northstar Air' }), 'Welcome to Northstar Air. How can I help with your booking?');

  const showError = (message = '') => { const e = $('#chat-error'); e.textContent = message; e.hidden = !message; };

  function start() {
    showError();
    chat = new NorthstarSession($<HTMLSelectElement>('#chat-variant').value as Variant, { principal: $<HTMLSelectElement>('#chat-principal').value as Principal });
    input.value = '';
    view.reset();
    render();
  }

  function render() {
    input.disabled = send.disabled = !chat;
    input.placeholder = chat ? 'Ask about a booking…' : 'Start a session to chat';
    if (!chat) return;
    $('#session-label').textContent = `${VARIANT_LABELS[chat.variant]} version · Signed in as ${PRINCIPAL_NAMES[chat.principal]}`;
    view.sync(chat.messages);

    const open = chat.escalations;
    $('#queue').hidden = !open.length;
    $('#queue-list').innerHTML = open.map((e) => `<li class="queue-item"><p><strong>Booking ${esc(e.ref)}</strong> · Caller signed in as ${esc(PRINCIPAL_NAMES[chat!.principal])} · <span class="pill ${e.owns ? 'ok' : 'bad'}">${e.owns ? 'Caller owns this booking' : 'Caller does not own this booking'}</span></p><p>Request: ${esc(e.request)}</p>${e.recipient ? `<p>Change delivery to <strong>${esc(e.recipient)}</strong></p>` : '<p>Wants booking details</p>'}${e.status === 'open' ? `<div class="queue-actions"><button class="button button-primary" type="button" data-resolve="${e.id}" data-approve="1">Approve</button><button class="text-link" type="button" data-resolve="${e.id}" data-approve="0">Decline</button></div>` : `<p class="pill">${e.status === 'approved' ? 'Approved' : 'Declined'}</p>`}</li>`).join('');

    $('#behind').hidden = !chat.turns.length;
    $('#behind-body').innerHTML = `<h3>What the agent understood</h3>${chat.turns.map((t, i) => `<div class="call"><p>Message ${i + 1} · ${LANG_LABELS[t.parsed.lang]} · decision <code>${esc(t.decision.kind)}</code>${t.decision.kind !== t.decisionIfEnglish.kind ? ` <span class="pill bad">In English it would have chosen ${esc(t.decisionIfEnglish.kind)}</span>` : ''}</p><p>${t.parsed.techniques.length ? t.parsed.techniques.map((x) => `<span class="pill">${esc(TECHNIQUE_LABELS[x])}</span>`).join(' ') : 'No attack technique detected'}</p></div>`).join('')}
      <h3>Tool calls</h3>${chat.events.map((e) => `<div class="call"><p><code>${esc(e.name)}</code>${e.authorized === undefined ? '' : ` <span class="pill ${e.authorized ? 'ok' : 'bad'}">${e.authorized ? 'Caller owns this booking' : 'Caller does not own this booking'}</span>`}</p>${e.note ? `<p class="note">${esc(e.note)}</p>` : ''}<pre>${esc(JSON.stringify({ input: e.input, output: e.output }, null, 2))}</pre></div>`).join('')}
      <h3>Test outbox</h3>${chat.outbox.length ? `<pre>${esc(JSON.stringify(chat.outbox, null, 2))}</pre>` : '<p>Nothing was sent.</p>'}`;
  }

  $('#setup-form').addEventListener('submit', (e) => { e.preventDefault(); start(); input.focus(); });

  $('#chat-form').addEventListener('submit', (e) => {
    e.preventDefault();
    if (!chat || !input.value.trim()) return;
    showError();
    try {
      // Only preset examples, or an email address the agent has just asked for, reach the agent.
      if (allowed.has(normalize(input.value)) || (chat.awaitingEmail && input.value.includes('@'))) chat.turn(input.value);
      else chat.decline(input.value);
      input.value = '';
    } catch (err) { showError((err as Error).message); }
    render();
    input.focus();
  });
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) $<HTMLFormElement>('#chat-form').requestSubmit(); });

  document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => {
    if (!chat) start();
    input.value = PRESETS.find((p) => p.id === b.dataset.preset)!.text;
    input.focus();
  }));

  $('#queue-list').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-resolve]');
    if (!b || !chat) return;
    chat.resolve(Number(b.dataset.resolve), b.dataset.approve === '1');
    render();
  });


  mountChecklist(document.querySelector('[data-checklist]')!, 'northstar-air');
</script>
