---
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
import Checklist from '../../../components/case-studies/Checklist.astro';
import { TOPIC_LABELS } from '../../../lib/case-studies/harbour-city';
import { LANG_LABELS } from '../../../lib/case-studies/runner';
---

<CaseStudyLayout title="Harbour City Services: start testing AI" description="A multilingual public services assistant. Ask the same question in five ways and compare the answers." backLink={{ href: '/case-studies/', label: 'All case studies' }} steps={{ slug: 'harbour-city', page: 3 }}>
  <div class="intro test-intro"><h1 class="headline">Start testing AI</h1><p>Test Harbour City Services against your list from <a class="text-link" href="/case-studies/harbour-city/before/">Before you start</a>, and note anything you find that is not on it.</p></div>

  <section id="start-testing" aria-label="Test the AI">
    <div class="chat-layout">
      <aside class="setup">
        <form id="setup-form">
          <h2>Start a session</h2>
          <div class="field"><label for="hc-variant">Version</label><select id="hc-variant"><option value="weak">Weak</option><option value="patched">Patched</option><option value="safe">Safe</option></select></div>
          <div class="field"><label for="hc-applicant">Signed in as</label><select id="hc-applicant"><option value="none">Not signed in</option><option value="siti">Siti Rahman (case HS-1042)</option><option value="arjun">Arjun Pillai (case HS-1043)</option><option value="chen">Chen Wei (case HS-1044)</option></select></div>
          <button class="button button-primary" type="submit">Start fresh session <span aria-hidden="true">→</span></button>
        </form>
        <div class="presets">
          <h2>Question bank</h2>
          <p>The same question in every language. Fills the message box.</p>
          <div class="field"><label for="hc-topic">Question</label><select id="hc-topic">{Object.entries(TOPIC_LABELS).map(([k, v]) => <option value={k}>{v}</option>)}</select></div>
          <div class="field"><label for="hc-lang">Language</label><select id="hc-lang">{Object.entries(LANG_LABELS).map(([k, v]) => <option value={k}>{v}</option>)}</select></div>
          <button class="text-link" type="button" id="hc-insert">Put this question in the message box <span aria-hidden="true">→</span></button>
        </div>
      </aside>
      <div class="test-main">
        <section class="chat" aria-labelledby="chat-title">
          <div class="chat-head"><h2 id="chat-title">Harbour City Services</h2><p id="session-label">No session yet</p></div>
          <div class="chat-body" id="messages" aria-live="polite"><p class="chat-empty">Hello. Ask me about the Household Support Grant.</p></div>
          <form id="chat-form" class="compose"><textarea id="chat-input" aria-label="Resident's question" placeholder="Start a session to ask" disabled></textarea><button class="button button-primary" type="submit" disabled>Send <span aria-hidden="true">→</span></button></form>
          <p class="form-error" id="chat-error" role="alert" hidden></p>
        </section>
        <Checklist caseId="harbour-city" />
      </div>
    </div>

    <details class="behind" id="behind" hidden><summary>What happened behind the scenes</summary><div id="behind-body"></div></details>
  </section>

  <p class="answers-link"><a class="text-link" href="/case-studies/harbour-city/answers/">Answer sheet: how each version behaves in every scenario <span aria-hidden="true">→</span></a></p>
</CaseStudyLayout>

<script>
  import { mountChecklist } from '../../../lib/case-studies/panels';
  import { CASES, DOCS, HarbourSession, QUESTIONS, TOPIC_LABELS, docById, type Applicant, type DocStatus, type Topic } from '../../../lib/case-studies/harbour-city';
  import { esc, LANG_LABELS, VARIANT_LABELS, type Lang, type Variant } from '../../../lib/case-studies/runner';
  import { createChatView } from '../../../lib/case-studies/chat-view';

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const input = $<HTMLTextAreaElement>('#chat-input');
  const send = $<HTMLButtonElement>('#chat-form button');
  let s: HarbourSession | null = null;
  const who = (a: Applicant) => (a === 'none' ? 'Resident' : CASES[a].name);
  const view = createChatView($('#messages'), () => ({ user: s ? who(s.setup.applicant) : 'Resident', assistant: 'Harbour City Services' }), 'Hello. Ask me about the Household Support Grant.');
  const showError = (m = '') => { const e = $('#chat-error'); e.textContent = m; e.hidden = !m; };

  function start() {
    showError();
    s = new HarbourSession($<HTMLSelectElement>('#hc-variant').value as Variant, { applicant: $<HTMLSelectElement>('#hc-applicant').value as Applicant });
    input.value = '';
    view.reset();
    render();
  }

  function render() {
    input.disabled = send.disabled = !s;
    input.placeholder = s ? 'Ask a question…' : 'Start a session to ask';
    if (!s) return;
    $('#session-label').textContent = `${VARIANT_LABELS[s.variant]} version · ${s.setup.applicant === 'none' ? 'Not signed in' : `Signed in as ${who(s.setup.applicant)}`}`;
    view.sync(s.messages);
    $('#behind').hidden = !s.turns.length;
    const statusPill = (st: DocStatus) => `<span class="pill ${st === 'official' ? 'ok' : st === 'restricted' ? '' : 'bad'}">${st === 'official' ? 'Official' : st === 'outdated' ? 'Outdated' : st === 'unreviewed' ? 'Unreviewed' : st === 'tampered' ? 'Tampered' : 'Restricted'}</span>`;
    $('#behind-body').innerHTML = `<h3>What the assistant understood, and where it looked</h3><div class="table-scroll"><table class="results"><thead><tr><th scope="col">#</th><th scope="col">Language</th><th scope="col">Question about</th><th scope="col">What the answer claimed</th><th scope="col">Retrieved from</th></tr></thead><tbody>${s.turns.map((t, i) => {
      const c = t.claims;
      const claims = [c.deadline && `Deadline ${c.deadline}`, c.incomeLimit && `Income limit SGD ${c.incomeLimit.toLocaleString('en-SG')}`, c.amount && `Grant amount SGD ${c.amount.toLocaleString('en-SG')}`, c.caseShown && `Showed case ${c.caseShown}`, c.refused && 'Refused', c.unsure && 'Said it was unsure', c.fabricated && 'Invented an answer'].filter(Boolean).join(' · ') || 'General answer';
      const src = c.source ? `${esc(docById(c.source).title)} ${statusPill(docById(c.source).status)}` : c.fabricated ? 'Nothing: the answer was invented' : 'None';
      return `<tr><td>${i + 1}</td><td>${esc(LANG_LABELS[t.lang])}</td><td>${esc(TOPIC_LABELS[t.topic])}${t.caseId ? ` (${esc(t.caseId)})` : ''}</td><td>${esc(claims)}</td><td>${src}</td></tr>`;
    }).join('')}</tbody></table></div>
      <h3>What is in the knowledge base</h3><div class="table-scroll"><table class="results"><thead><tr><th scope="col">Page</th><th scope="col">Status</th><th scope="col">Details</th></tr></thead><tbody>${DOCS.map((d) => `<tr><td>${esc(d.title)}</td><td>${statusPill(d.status)}</td><td>${esc(d.detail)}</td></tr>`).join('')}</tbody></table></div>`;
  }

  $('#setup-form').addEventListener('submit', (e) => { e.preventDefault(); start(); input.focus(); });
  $('#chat-form').addEventListener('submit', (e) => {
    e.preventDefault();
    if (!s || !input.value.trim()) return;
    showError();
    try { s.ask(input.value); input.value = ''; } catch (err) { showError((err as Error).message); }
    render();
    input.focus();
  });
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) $<HTMLFormElement>('#chat-form').requestSubmit(); });

  $('#hc-insert').addEventListener('click', () => {
    if (!s) start();
    input.value = QUESTIONS[$<HTMLSelectElement>('#hc-topic').value as Topic][$<HTMLSelectElement>('#hc-lang').value as Lang];
    input.focus();
  });


  mountChecklist(document.querySelector('[data-checklist]')!, 'harbour-city');
</script>
