---
import '../styles/site.css';

const workshopTopics = [
  'Identify consequential failure modes',
  'Run structured adversarial tests',
  'Test tools, permissions, and oversight',
  'Turn findings into repeatable evaluations',
  'Evaluate mitigations and regressions',
  'Build evidence for deployment decisions',
];

const audiences = ['Public sector', 'Product & engineering', 'Legal & policy', 'Risk & compliance', 'Cybersecurity', 'Executive leadership'];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Practical, multilingual AI evaluation and red-teaming workshops for public institutions and organizations across Asia." />
    <meta name="theme-color" content="#591c2d" />
    <meta property="og:title" content="Asian AI Evaluation Institute" />
    <meta property="og:description" content="Test AI in context, before people depend on it." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Noto+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>Asian AI Evaluation Institute | Test AI in context</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <p class="wordmark"><span class="mark" aria-hidden="true">A</span><span>Asian AI<br />Evaluation Institute</span></p>
      <a class="text-link" href="/demos/">Training demos <span aria-hidden="true">→</span></a>
    </header>

    <main id="main">
      <section class="workshop" aria-labelledby="workshop-title">
        <div class="workshop-ticket reveal">
          <h1 id="workshop-title">Break AI<br />Before Deploying AI</h1>
          <p class="workshop-lede">A hands-on introduction to evaluating and red teaming generative and agentic AI systems before deployment.</p>
          <div class="workshop-body">
            <div><h2>Participants learn to</h2><ul class="check-list">{workshopTopics.map((topic) => <li>{topic}</li>)}</ul></div>
            <div><h2>Designed for</h2><div class="audience-list">{audiences.map((audience) => <span>{audience}</span>)}</div><p class="access-note">No advanced coding experience required. Participants work in interdisciplinary groups because effective evaluation needs technical, policy, legal, and operational expertise.</p></div>
          </div>
          <div class="ticket-bottom"><p>Public workshop, <strong>29 September 2026</strong>, Singapore</p><a class="button button-primary" href="https://peatix.com/event/5138876" target="_blank" rel="noreferrer">Find the event <span aria-hidden="true">↗</span></a></div>
        </div>
        <div class="corporate-callout reveal">
          <h2>Bring the workshop to your team.</h2>
          <div><p>We adapt the material to your systems, responsibilities, and deployment environment. Formats can support public agencies, regulated organizations, cross-functional product teams, and leadership groups.</p><button class="text-link" type="button" data-open-request aria-haspopup="dialog">Plan a private workshop <span aria-hidden="true">→</span></button></div>
        </div>
      </section>

      <section class="rerun" aria-labelledby="sincon-title">
        <div class="rerun-heading reveal"><h2 class="headline" id="sincon-title">Catch it at SINCON 2026.</h2><p>A two-hour edition of Break AI Before Deploying AI, in the Workshop Track at Infosec In the City’s SINCON conference.</p></div>
        <div class="rerun-card reveal">
          <p class="rerun-date"><span>Fri</span><strong>16</strong><span>Oct 2026</span></p>
          <dl class="rerun-details">
            <div><dt>Time</dt><dd>13:30–15:30 SGT</dd></div>
            <div><dt>Room</dt><dd>Workshop Room, Level 5</dd></div>
            <div><dt>Venue</dt><dd>voco Orchard Singapore, 581 Orchard Rd</dd></div>
          </dl>
          <a class="button button-primary" href="https://www.infosec-city.com/" target="_blank" rel="noreferrer">Get SINCON tickets <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="instructor" aria-labelledby="instructor-title">
        <div class="instructor-heading reveal"><h2 class="headline" id="instructor-title">Adrianna Tan</h2><p>AI safety and evaluation practitioner working on how organizations test AI systems before deploying them in the real world.</p></div>
        <div class="instructor-details reveal"><p>Adrianna has led AI red-teaming and evaluation work for the U.S. Department of Defense, Singapore’s IMDA, Fortune 500 companies, healthcare organizations, and governments. In 2026, she spoke on AI testing and evaluation at the United Nations’ AI for Good Global Summit.</p><p>Previously, she spent five years as a Director of Product for the City and County of San Francisco. Her work now focuses on practical AI evaluation, agentic AI, multilingual and multicultural testing, and credible evidence for high-stakes deployment.</p><a class="text-link" href="https://futureethics.ai/about/" target="_blank" rel="noreferrer">More about Adrianna <span aria-hidden="true">↗</span></a></div>
      </section>

      <section class="contact" id="contact" aria-labelledby="contact-title">
        <div class="contact-grid" aria-hidden="true"></div>
        <div class="contact-copy reveal"><h2 class="headline" id="contact-title">What does your team need to learn before deploying AI?</h2><p>Tell us about your organization, the systems you are considering, and the decisions your team is responsible for. We can shape a private workshop around that context.</p><button class="button button-primary" type="button" data-open-request aria-haspopup="dialog">Request a workshop <span aria-hidden="true">→</span></button></div>
        <div class="contact-note reveal"><h3>Suitable for</h3><ul><li>Public agencies and statutory bodies</li><li>Regulated and high-stakes organizations</li><li>Cross-functional product and governance teams</li><li>Leadership and procurement groups</li></ul></div>
      </section>
    </main>

    <footer>
      <p class="wordmark"><span class="mark" aria-hidden="true">A</span><span>Asian AI<br />Evaluation Institute</span></p>
      <p>Practical AI evaluation for the environments where systems meet people.</p>
      <small>© 2026 Asian AI Evaluation Institute</small>
    </footer>

    <dialog class="request-dialog" id="request-dialog" aria-labelledby="request-title">
      <div class="request-panel">
        <button class="dialog-close" type="button" data-close-request aria-label="Close">×</button>
        <div data-request-form-view>
          <h2 id="request-title">Request a workshop</h2>
          <p class="request-intro">Tell us about your organization, the systems you are considering, and the decisions your team is responsible for. We will reply within a few working days.</p>
          <form name="workshop-request" method="POST" action="/" data-netlify="true" netlify-honeypot="bot-field" novalidate>
            <input type="hidden" name="form-name" value="workshop-request" />
            <p class="honeypot" aria-hidden="true"><label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
            <div class="field-row">
              <div class="field"><label for="req-name">Name</label><input id="req-name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="req-name-error" /><p class="field-error" id="req-name-error"></p></div>
              <div class="field"><label for="req-email">Work email</label><input id="req-email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="req-email-error" /><p class="field-error" id="req-email-error"></p></div>
            </div>
            <div class="field-row">
              <div class="field"><label for="req-org">Organization</label><input id="req-org" name="organization" type="text" autocomplete="organization" required maxlength="200" aria-describedby="req-org-error" /><p class="field-error" id="req-org-error"></p></div>
              <div class="field"><label for="req-role">Role <span>(optional)</span></label><input id="req-role" name="role" type="text" autocomplete="organization-title" maxlength="120" /></div>
            </div>
            <div class="field"><label for="req-size">Approximate group size <span>(optional)</span></label><select id="req-size" name="group-size"><option value="">Choose one</option><option>Under 15 people</option><option>15 to 30 people</option><option>More than 30 people</option><option>Not sure yet</option></select></div>
            <div class="field"><label for="req-message">What should the workshop focus on?</label><textarea id="req-message" name="message" rows="5" required maxlength="4000" aria-describedby="req-message-error"></textarea><p class="field-error" id="req-message-error"></p></div>
            <p class="form-error" role="alert" hidden>Your request could not be sent. Please check your connection and try again.</p>
            <button class="button button-primary" type="submit">Send request <span aria-hidden="true">→</span></button>
          </form>
        </div>
        <div class="request-success" data-request-success hidden>
          <h2 tabindex="-1">Thank you.</h2>
          <p>Your request has been sent. We have emailed a confirmation to <strong data-success-email></strong> and will be in touch within a few working days.</p>
          <button class="button button-primary" type="button" data-close-request>Close</button>
        </div>
      </div>
    </dialog>

    <script>
      const observer = new IntersectionObserver((entries) => { entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }); }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      const dialog = document.querySelector<HTMLDialogElement>('#request-dialog')!;
      const form = dialog.querySelector('form')!;
      const formView = dialog.querySelector<HTMLElement>('[data-request-form-view]')!;
      const successView = dialog.querySelector<HTMLElement>('[data-request-success]')!;
      const formError = form.querySelector<HTMLElement>('.form-error')!;
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]')];
      const messages: Record<string, string> = { name: 'Please enter your name.', email: 'Please enter a valid email address.', organization: 'Please enter your organization.', message: 'Please tell us a little about what you need.' };
      let attempted = false;

      const resetDialog = () => { form.reset(); attempted = false; fields.forEach((field) => showFieldError(field, false)); formError.hidden = true; formView.hidden = false; successView.hidden = true; };
      const showFieldError = (field: HTMLInputElement | HTMLTextAreaElement, show: boolean) => {
        const error = document.getElementById(`${field.id}-error`);
        field.setAttribute('aria-invalid', String(show));
        if (error) error.textContent = show ? messages[field.name] : '';
      };
      const validate = () => { let firstInvalid: HTMLElement | null = null; fields.forEach((field) => { const bad = !field.checkValidity() || !field.value.trim(); showFieldError(field, bad); if (bad && !firstInvalid) firstInvalid = field; }); return firstInvalid; };

      document.querySelectorAll('[data-open-request]').forEach((button) => button.addEventListener('click', () => { if (!successView.hidden) resetDialog(); dialog.showModal(); }));
      dialog.querySelectorAll('[data-close-request]').forEach((button) => button.addEventListener('click', () => dialog.close()));
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
      fields.forEach((field) => field.addEventListener('input', () => { if (attempted) showFieldError(field, !field.checkValidity() || !field.value.trim()); }));

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        attempted = true;
        formError.hidden = true;
        const firstInvalid = validate();
        if (firstInvalid) { (firstInvalid as HTMLElement).focus(); return; }
        submit.disabled = true;
        submit.setAttribute('aria-busy', 'true');
        submit.firstChild!.textContent = 'Sending… ';
        try {
          const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
          const response = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
          if (!response.ok) throw new Error(`Status ${response.status}`);
          dialog.querySelector('[data-success-email]')!.textContent = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
          formView.hidden = true;
          successView.hidden = false;
          successView.querySelector<HTMLElement>('h2')!.focus();
        } catch {
          formError.hidden = false;
        } finally {
          submit.disabled = false;
          submit.removeAttribute('aria-busy');
          submit.firstChild!.textContent = 'Send request ';
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* Workshop */
  .workshop { width: var(--page); margin: 0 auto; }
  .workshop-ticket { padding: var(--panel-pad); color: var(--paper); background: var(--green); border-radius: var(--radius-panel); }
  .workshop-ticket h1 { margin: 0 0 var(--space-md); color: var(--coral); font: 700 clamp(3.5rem, 9vw, 9rem)/.88 var(--display); letter-spacing: -.065em; }
  .workshop-lede { max-width: 34ch; margin: 0; font-size: clamp(1.2rem, 2vw, 1.75rem); line-height: 1.45; }
  .workshop-body { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-lg) clamp(40px, 8vw, 128px); margin: var(--space-xl) 0 var(--space-lg); padding-top: var(--space-lg); border-top: 1px solid var(--line-light); }
  .workshop-body h2 { margin: 0 0 var(--space-sm); color: var(--coral); font: 650 16px/1.2 var(--display); }
  .check-list { list-style: none; margin: 0; padding: 0; } .check-list li { position: relative; padding: 12px 0 12px 28px; border-bottom: 1px solid var(--line-light); font-weight: 500; } .check-list li::before { content: '×'; position: absolute; left: 2px; top: 11px; color: var(--coral); font: 700 17px/1 var(--display); }
  .audience-list { display: flex; flex-wrap: wrap; gap: var(--space-xs); padding-top: 4px; } .audience-list span { padding: 8px 12px; border: 1px solid color-mix(in oklch, var(--paper) 60%, transparent); border-radius: 999px; font: 600 13px/1 var(--display); }
  .access-note { max-width: 52ch; margin: var(--space-md) 0 0; color: color-mix(in oklch, var(--paper) 85%, transparent); font-size: 15px; }
  .ticket-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-md); padding-top: var(--space-md); border-top: 1px solid var(--line-light); } .ticket-bottom p { margin: 0; font: 500 17px/1.3 var(--display); } .ticket-bottom strong { font-weight: 700; }
  .corporate-callout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md) clamp(40px, 8vw, 128px); margin-top: var(--space-sm); padding: var(--panel-pad); color: var(--ink); background: var(--coral); border-radius: var(--radius-panel); }
  .corporate-callout h2 { margin: 0; font: 650 clamp(2.1rem, 4vw, 4rem)/.97 var(--display); letter-spacing: -.05em; text-wrap: balance; }
  .corporate-callout p { max-width: 52ch; margin: 0 0 var(--space-sm); font-size: 17px; }

  /* SINCON */
  .rerun { display: grid; grid-template-columns: .9fr 1.1fr; gap: var(--space-lg) clamp(40px, 7vw, 112px); align-items: center; width: var(--page); margin: 0 auto; padding-block: var(--space-section); }
  .rerun-heading p { max-width: 40ch; margin: var(--space-md) 0 0; font-size: 18px; }
  .rerun-card { display: grid; grid-template-columns: auto 1fr; overflow: hidden; border: 1px solid var(--ink); border-radius: var(--radius-panel); background: var(--rice); }
  .rerun-date { grid-row: span 2; display: grid; align-content: center; justify-items: center; margin: 0; padding: var(--space-lg) clamp(24px, 3vw, 44px); background: var(--coral); border-right: 1px solid var(--ink); font: 650 13px/1.2 var(--display); }
  .rerun-date strong { margin: 4px 0; font: 700 clamp(4rem, 7vw, 6.5rem)/.9 var(--display); letter-spacing: -.06em; }
  .rerun-details { margin: 0; padding: var(--space-md) clamp(20px, 2.5vw, 36px) 0; } .rerun-details div { display: grid; grid-template-columns: 72px 1fr; gap: var(--space-sm); padding: 12px 0; border-bottom: 1px solid var(--line); } .rerun-details dt { color: color-mix(in oklch, var(--ink) 65%, transparent); font: 600 14px/1.5 var(--display); } .rerun-details dd { margin: 0; font-weight: 500; }
  .rerun-card .button { grid-column: 2; justify-self: start; margin: var(--space-md) clamp(20px, 2.5vw, 36px) clamp(24px, 3vw, 36px); } .rerun-card .button-primary:hover { background: var(--paper); border-color: var(--ink); }

  /* Instructor */
  .instructor { display: grid; grid-template-columns: .9fr 1.1fr; gap: var(--space-lg) clamp(40px, 7vw, 112px); width: var(--page); margin: 0 auto; padding-block: var(--space-section); border-top: 1px solid var(--line); }
  .instructor-heading p { max-width: 36ch; margin: var(--space-md) 0 0; font-size: 18px; }
  .instructor-details p { max-width: 64ch; margin: 0 0 var(--space-md); font-size: 17px; } .instructor-details p:first-child { margin-top: 6px; }

  /* Contact */
  .contact { position: relative; overflow: hidden; display: grid; grid-template-columns: 1.3fr .7fr; align-items: end; gap: var(--space-xl) clamp(40px, 8vw, 128px); padding: var(--space-section) var(--inset); color: var(--paper); background: var(--green-dark); }
  .contact-grid { position: absolute; inset: 0; opacity: .1; pointer-events: none; background-image: linear-gradient(to right, transparent calc(100% - 1px), var(--paper) 1px), linear-gradient(to bottom, transparent calc(100% - 1px), var(--paper) 1px); background-size: 10vw 10vw; mask-image: linear-gradient(to bottom, black, transparent 88%); }
  .contact::after { content: ''; position: absolute; width: 520px; height: 520px; right: -150px; top: -220px; border: 1px solid color-mix(in oklch, var(--paper) 26%, transparent); border-radius: 50%; box-shadow: 0 0 0 70px color-mix(in oklch, var(--paper) 3%, transparent), 0 0 0 140px color-mix(in oklch, var(--paper) 2%, transparent); }
  .contact-copy, .contact-note { position: relative; z-index: 2; }
  .contact h2 { max-width: 16ch; color: var(--coral); }
  .contact-copy p { max-width: 52ch; margin: var(--space-md) 0 var(--space-lg); font-size: 18px; line-height: 1.65; }
  .contact-note { padding-block: var(--space-md); border-block: 1px solid var(--line-light); }
  .contact-note h3 { margin: 0 0 var(--space-sm); font: 650 16px/1.2 var(--display); }
  .contact-note ul { margin: 0; padding-left: 20px; font-size: 15px; line-height: 1.75; }


  /* Request dialog */
  html:has(.request-dialog[open]) { overflow: hidden; }
  .request-dialog { width: min(680px, calc(100vw - 2 * var(--gutter))); max-height: calc(100dvh - 32px); padding: 0; color: var(--ink); background: var(--paper); border: 0; border-radius: var(--radius-panel); overflow: auto; opacity: 0; transform: translateY(16px); transition: opacity 300ms var(--ease), transform 300ms var(--ease), overlay 300ms allow-discrete, display 300ms allow-discrete; }
  .request-dialog[open] { opacity: 1; transform: none; }
  @starting-style { .request-dialog[open] { opacity: 0; transform: translateY(16px); } }
  .request-dialog::backdrop { background: color-mix(in oklch, var(--green-dark) 75%, transparent); }
  .request-panel { position: relative; padding: clamp(28px, 5vw, 52px); }
  .request-panel h2 { margin: 0 48px var(--space-sm) 0; font: 650 clamp(2rem, 4vw, 2.75rem)/1 var(--display); letter-spacing: -.045em; } .request-panel h2:focus { outline: none; }
  .request-intro, .request-success p { max-width: 54ch; margin: 0 0 var(--space-md); font-size: 16px; }
  .dialog-close { position: absolute; top: 16px; right: 16px; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; color: var(--ink); background: transparent; border: 1px solid var(--line); border-radius: 50%; font: 400 24px/1 var(--display); cursor: pointer; transition: background-color 180ms ease; } .dialog-close:hover { background: var(--rice); }
  .request-dialog form { display: grid; gap: var(--space-sm); }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-sm); }
  .field { display: grid; gap: 6px; align-content: start; }
  .field label { font: 600 14px/1.3 var(--display); } .field label span { font-weight: 500; opacity: .6; }
  .field input, .field select, .field textarea { width: 100%; min-height: 48px; padding: 12px 14px; color: var(--ink); background: oklch(98.5% .01 70); border: 1px solid color-mix(in oklch, var(--ink) 45%, transparent); border-radius: var(--radius-control); font: 400 16px/1.4 var(--body); transition: border-color 180ms ease; }
  .field textarea { resize: vertical; min-height: 128px; }
  .field input:hover, .field select:hover, .field textarea:hover { border-color: var(--ink); }
  .field input:focus-visible, .field select:focus-visible, .field textarea:focus-visible { outline: 3px solid var(--coral); outline-offset: 1px; border-color: var(--ink); }
  .field [aria-invalid="true"] { border-color: oklch(50% .18 28); border-width: 2px; padding: 11px 13px; }
  .field-error { min-height: 0; margin: 0; color: oklch(45% .17 28); font-size: 14px; font-weight: 500; } .field-error:empty { display: none; }
  .form-error { margin: 0; padding: 12px 14px; color: oklch(40% .15 28); background: oklch(94% .04 28); border-radius: var(--radius-control); font-size: 15px; }
  .request-dialog .button-primary { justify-self: start; margin-top: var(--space-xs); } .request-dialog .button-primary:hover { border-color: var(--ink); }
  .request-dialog .button[disabled] { cursor: progress; opacity: .7; transform: none; }
  .honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  /* Motion */
  .reveal { opacity: 0; transform: translateY(20px); transition: opacity 600ms cubic-bezier(.16,1,.3,1), transform 600ms cubic-bezier(.16,1,.3,1); } .reveal.is-visible { opacity: 1; transform: none; }

  @media (max-width: 1000px) {
    .workshop-body, .corporate-callout, .rerun, .instructor, .contact { grid-template-columns: 1fr; }
    .rerun { align-items: start; }
  }
  @media (max-width: 760px) {
    .workshop-ticket h1 { font-size: clamp(3.2rem, 16vw, 5.5rem); }
    .headline { font-size: clamp(2.5rem, 11vw, 4rem); }
    .ticket-bottom { flex-direction: column; align-items: flex-start; }
    .rerun-card { grid-template-columns: 1fr; }
    .rerun-date { grid-row: auto; grid-auto-flow: column; align-items: baseline; justify-content: start; gap: 12px; padding: var(--space-sm) 20px; border-right: 0; border-bottom: 1px solid var(--ink); }
    .rerun-date strong { margin: 0; font-size: 3.2rem; }
    .rerun-details div { grid-template-columns: 60px 1fr; }
    .rerun-card .button { grid-column: 1; }
    .field-row { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; } .reveal { opacity: 1; transform: none; } }
</style>
