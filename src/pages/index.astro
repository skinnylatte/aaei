---
const workshopTopics = [
  'Identify consequential failure modes',
  'Run structured adversarial tests',
  'Test tools, permissions, and oversight',
  'Turn findings into repeatable evaluations',
  'Evaluate mitigations and regressions',
  'Build evidence for deployment decisions',
];

const audiences = ['Public sector', 'Product & engineering', 'Legal & policy', 'Risk & compliance', 'Cybersecurity', 'Executive leadership'];

const evaluationPath = [
  ['01', 'Context', 'Define where the system will operate, who it will affect, and what failure would mean.'],
  ['02', 'Failure modes', 'Prioritize harms that matter in the actual service, jurisdiction, language, and workflow.'],
  ['03', 'Adversarial tests', 'Make the system fail through structured human testing and repeatable evaluation cases.'],
  ['04', 'Evidence', 'Inspect behavior, tools, permissions, and traces. Record findings that others can verify.'],
  ['05', 'Decisions', 'Test mitigations, rerun evaluations, and support a clear deployment decision.'],
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Practical, multilingual AI evaluation and red-teaming workshops for public institutions and organizations across Asia." />
    <meta name="theme-color" content="#591c2d" />
    <meta property="og:title" content="Asian AI Evaluation Institute" />
    <meta property="og:description" content="Test AI in context, before people depend on it." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Noto+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>Asian AI Evaluation Institute | Test AI in context</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" id="top" data-nav>
      <a class="wordmark" href="#top" aria-label="Asian AI Evaluation Institute, home">
        <span class="mark" aria-hidden="true">A</span>
        <span>Asian AI<br />Evaluation Institute</span>
      </a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
      <nav id="site-nav" aria-label="Main navigation">
        <a href="#method">How we work</a><a href="#about">About</a>
        <a class="nav-action" href="#workshops">Workshops <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="main">
      <section class="workshop section" id="workshops" aria-labelledby="workshop-title">
        <div class="workshop-ticket reveal">
          <div class="ticket-top"><p>Practical workshop / Singapore</p><span>AAEI–001</span></div>
          <h2 id="workshop-title">Break AI<br />Before Deploying AI</h2>
          <p class="workshop-lede">A hands-on introduction to evaluating and red teaming generative and agentic AI systems before deployment.</p>
          <div class="workshop-body">
            <div><h3>Participants learn to</h3><ul class="check-list">{workshopTopics.map((topic) => <li>{topic}</li>)}</ul></div>
            <div><h3>Designed for</h3><div class="audience-list">{audiences.map((audience) => <span>{audience}</span>)}</div><p class="access-note">No advanced coding experience required. Participants work in interdisciplinary groups because effective evaluation needs technical, policy, legal, and operational expertise.</p></div>
          </div>
          <div class="ticket-bottom"><div><p>Upcoming public workshop</p><strong>29 September 2026 · Singapore</strong></div><a class="button button-dark" href="https://peatix.com/search?q=Break%20AI%20Before%20Deploying%20AI" target="_blank" rel="noreferrer">Find the event <span aria-hidden="true">↗</span></a></div>
        </div>
        <div class="corporate-callout reveal">
          <p class="section-number">For organizations</p><h3>Bring the workshop to your team.</h3><p>We adapt the material to your systems, responsibilities, and deployment environment. Formats can support public agencies, regulated organizations, cross-functional product teams, and leadership groups.</p>
          <a class="text-link light" href="#contact">Plan a private workshop <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="method section" id="method" aria-labelledby="method-title">
        <div class="section-heading reveal"><p class="section-number">02 / How we work</p><h2 id="method-title">From a worrying failure to usable evidence.</h2><p>Evaluation is most useful when it connects technical behavior to a real decision. Our workshops teach a practical path teams can reuse.</p></div>
        <ol class="method-path reveal">{evaluationPath.map(([num, title, text]) => <li><span>{num}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol>
      </section>

      <section class="practice section" aria-labelledby="practice-title">
        <div class="practice-title reveal"><p class="section-number">03 / What good evaluation changes</p><h2 id="practice-title">Not a certificate.<br />A stronger decision.</h2></div>
        <div class="outcomes reveal">
          <article><span aria-hidden="true">A</span><h3>A shared language for failure</h3><p>Technical, policy, legal, security, and operational teams can reason about the same evidence.</p></article>
          <article><span aria-hidden="true">B</span><h3>Tests that survive the workshop</h3><p>Important findings become evaluation cases that can be rerun after a model, prompt, tool, or safeguard changes.</p></article>
          <article><span aria-hidden="true">C</span><h3>Better deployment boundaries</h3><p>Teams learn where automation is appropriate, where human oversight belongs, and what evidence is still missing.</p></article>
        </div>
      </section>

      <section class="about section" id="about" aria-labelledby="about-title">
        <div class="about-stamp reveal" aria-hidden="true"><span>AAEI</span><small>Practice<br />Evidence<br />Context</small></div>
        <div class="about-copy reveal"><p class="section-number">About the institute</p><h2 id="about-title">Evaluation belongs in the hands of the people responsible for deployment.</h2><p>The Asian AI Evaluation Institute is an emerging practice and learning institute focused on practical AI evaluation across Asian contexts. We convene interdisciplinary groups, teach hands-on methods, and develop approaches to multilingual and multicultural testing.</p><p>Our work begins from a simple belief: no single profession, benchmark, or country has all the expertise needed to understand how AI fails.</p></div>
      </section>

      <section class="instructor section" aria-labelledby="instructor-title">
        <div class="instructor-heading reveal"><p class="section-number">Workshop lead</p><h2 id="instructor-title">Adrianna Tan</h2><p>AI safety and evaluation practitioner working on how organizations test AI systems before deploying them in the real world.</p></div>
        <div class="instructor-details reveal"><p>Adrianna has led AI red-teaming and evaluation work for the U.S. Department of Defense, Singapore’s IMDA, Fortune 500 companies, healthcare organizations, and governments. In 2026, she spoke on AI testing and evaluation at the United Nations’ AI for Good Global Summit.</p><p>Previously, she spent five years as a Director of Product for the City and County of San Francisco. Her work now focuses on practical AI evaluation, agentic AI, multilingual and multicultural testing, and credible evidence for high-stakes deployment.</p><a class="text-link" href="https://futureethics.ai/about/" target="_blank" rel="noreferrer">More about Adrianna <span aria-hidden="true">↗</span></a></div>
      </section>

      <section class="contact" id="contact" aria-labelledby="contact-title">
        <div class="contact-grid" aria-hidden="true"></div>
        <div class="contact-copy reveal"><p class="section-number">Start here</p><h2 id="contact-title">What does your team need to learn before deploying AI?</h2><p>Tell us about your organization, the systems you are considering, and the decisions your team is responsible for. We can shape a private workshop around that context.</p><a class="button button-primary" href="https://futureethics.ai/#contact" target="_blank" rel="noreferrer">Request a workshop <span aria-hidden="true">↗</span></a></div>
        <div class="contact-note reveal"><p>Suitable for</p><ul><li>Public agencies and statutory bodies</li><li>Regulated and high-stakes organizations</li><li>Cross-functional product and governance teams</li><li>Leadership and procurement groups</li></ul></div>
      </section>
    </main>

    <footer>
      <a class="wordmark footer-mark" href="#top"><span class="mark" aria-hidden="true">A</span><span>Asian AI<br />Evaluation Institute</span></a>
      <p>Practical AI evaluation for the environments where systems meet people.</p><div><a href="#workshops">Workshops</a><a href="#method">How we work</a><a href="#about">About</a></div><small>© 2026 Asian AI Evaluation Institute</small>
    </footer>

    <script>
      const header = document.querySelector('[data-nav]');
      const toggle = document.querySelector('.nav-toggle');
      const nav = document.querySelector('#site-nav');
      toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') === 'true'; toggle.setAttribute('aria-expanded', String(!open)); header?.classList.toggle('nav-open', !open); });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { toggle?.setAttribute('aria-expanded', 'false'); header?.classList.remove('nav-open'); }));
      const observer = new IntersectionObserver((entries) => { entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }); }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

<style is:global>
  :root { --ink: oklch(23% .045 350); --paper: oklch(96% .025 70); --green: oklch(35% .105 355); --green-dark: oklch(25% .075 355); --coral: oklch(69% .16 43); --rice: oklch(91% .045 65); --mist: oklch(72% .055 5); --line: color-mix(in oklch, var(--ink) 20%, transparent); --display: 'Manrope', Arial, sans-serif; --body: 'Noto Sans', Arial, sans-serif; --page: min(1480px, calc(100vw - 40px)); }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--paper); }
  body { margin: 0; color: var(--ink); background: var(--paper); font-family: var(--body); font-size: 16px; line-height: 1.6; -webkit-font-smoothing: antialiased; }
  body::before { content: ''; position: fixed; inset: 0; z-index: 1000; pointer-events: none; opacity: .18; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.16'/%3E%3C/svg%3E"); mix-blend-mode: multiply; }
  a { color: inherit; } button, a { -webkit-tap-highlight-color: transparent; } ::selection { background: var(--coral); color: var(--ink); }
  .skip-link { position: fixed; top: 8px; left: 8px; z-index: 2000; transform: translateY(-150%); background: var(--coral); padding: 10px 16px; font-weight: 700; } .skip-link:focus { transform: none; } :focus-visible { outline: 3px solid var(--coral); outline-offset: 4px; }
  .site-header { position: relative; z-index: 20; width: var(--page); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 22px 0; color: var(--ink); border-bottom: 1px solid var(--line); }
  .wordmark { display: inline-flex; align-items: center; gap: 11px; font: 600 13px/1.08 var(--display); text-decoration: none; letter-spacing: -.02em; } .mark { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid currentColor; border-radius: 50%; font-size: 18px; font-weight: 700; }
  .site-header nav { display: flex; align-items: center; gap: 30px; font: 600 13px/1 var(--display); } .site-header nav a { text-decoration: none; } .site-header nav > a:not(.nav-action) { position: relative; }
  .site-header nav > a:not(.nav-action)::after { content: ''; position: absolute; left: 0; right: 100%; bottom: -7px; height: 1px; background: currentColor; transition: right 180ms cubic-bezier(.25,1,.5,1); } .site-header nav > a:hover::after { right: 0; }
  .nav-action { padding: 11px 14px; color: var(--ink); background: var(--coral); border: 1px solid var(--coral); border-radius: 2px; transition: transform 180ms cubic-bezier(.25,1,.5,1), background 180ms ease; } .nav-action:hover { transform: translateY(-2px); background: var(--paper); } .nav-toggle { display: none; border: 1px solid currentColor; background: transparent; color: inherit; font: 600 13px var(--display); padding: 9px 12px; }
  .hero { position: relative; min-height: 920px; padding: 190px max(20px, calc((100vw - 1480px)/2)) 70px; overflow: hidden; color: var(--paper); background: var(--green); display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(280px, .45fr); grid-template-rows: 1fr auto; gap: 60px clamp(40px, 7vw, 120px); }
  .hero-grid, .contact-grid { position: absolute; inset: 0; opacity: .19; pointer-events: none; background-image: linear-gradient(to right, transparent calc(100% - 1px), var(--paper) 1px), linear-gradient(to bottom, transparent calc(100% - 1px), var(--paper) 1px); background-size: 10vw 10vw; mask-image: linear-gradient(to bottom, black, transparent 88%); }
  .hero::after { content: ''; position: absolute; width: clamp(330px, 45vw, 680px); aspect-ratio: 1; right: -9vw; bottom: -27%; border: 1px solid color-mix(in oklch, var(--paper) 45%, transparent); border-radius: 50%; box-shadow: 0 0 0 5vw color-mix(in oklch, var(--paper) 5%, transparent), 0 0 0 10vw color-mix(in oklch, var(--paper) 4%, transparent); }
  .hero-copy, .hero-index, .hero-note { position: relative; z-index: 2; } .eyebrow, .section-number { margin: 0 0 28px; font: 650 11px/1 var(--display); letter-spacing: .09em; text-transform: uppercase; }
  .hero h1 { margin: 0; max-width: 1020px; font: 700 clamp(3.55rem, 7.8vw, 8.7rem)/.88 var(--display); letter-spacing: -.062em; text-wrap: balance; } .hero h1 span { color: var(--coral); }
  .hero-intro { max-width: 650px; margin: 38px 0 0; font-size: clamp(1.05rem, 1.5vw, 1.35rem); line-height: 1.55; } .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 26px; margin-top: 42px; }
  .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 34px; padding: 14px 18px; border: 1px solid currentColor; border-radius: 2px; font: 650 14px/1 var(--display); text-decoration: none; transition: transform 180ms cubic-bezier(.25,1,.5,1), background 180ms ease; } .button:hover { transform: translateY(-2px); }
  .button-primary { min-width: 235px; color: var(--ink); background: var(--coral); border-color: var(--coral); } .button-primary:hover { background: var(--paper); border-color: var(--paper); } .button-dark { color: var(--paper); background: var(--ink); } .button-dark:hover { color: var(--ink); background: var(--paper); }
  .text-link { display: inline-flex; gap: 14px; align-items: center; font: 650 14px/1.3 var(--display); text-underline-offset: 5px; text-decoration-thickness: 1px; } .text-link span { transition: transform 180ms cubic-bezier(.25,1,.5,1); } .text-link:hover span { transform: translateX(5px); }
  .hero-index { align-self: start; margin-top: 8px; } .hero-index > p, .coordinates { font: 600 10px/1.4 var(--display); letter-spacing: .08em; text-transform: uppercase; opacity: .72; }
  .hero-index ol { margin: 21px 0 44px; padding: 0; list-style: none; border-top: 1px solid color-mix(in oklch, var(--paper) 28%, transparent); } .hero-index li { display: grid; grid-template-columns: 34px 1fr; padding: 12px 0; border-bottom: 1px solid color-mix(in oklch, var(--paper) 28%, transparent); font: 500 13px/1.25 var(--display); } .hero-index li span { opacity: .5; }
  .hero-note { grid-column: 1; align-self: end; display: grid; grid-template-columns: 18px minmax(0, 550px); gap: 18px; padding-top: 22px; border-top: 1px solid color-mix(in oklch, var(--paper) 28%, transparent); } .hero-note p { margin: 0; font-size: 14px; line-height: 1.5; } .note-pin { width: 10px; height: 10px; margin-top: 4px; border-radius: 50%; background: var(--coral); box-shadow: 0 0 0 4px color-mix(in oklch, var(--coral) 25%, transparent); }
  .manifesto { display: grid; grid-template-columns: minmax(120px, .35fr) 1.65fr; gap: 40px; width: var(--page); margin: 0 auto; padding: clamp(90px, 12vw, 180px) 0; border-bottom: 1px solid var(--line); } .manifesto > p { margin: 12px 0 0; font: 650 11px/1 var(--display); letter-spacing: .09em; text-transform: uppercase; } blockquote { margin: 0; max-width: 1050px; font: 650 clamp(2.4rem, 5.5vw, 5.8rem)/.98 var(--display); letter-spacing: -.05em; } blockquote em { color: var(--green); font-style: normal; }
  .section { width: var(--page); margin: 0 auto; padding: clamp(95px, 12vw, 170px) 0; } .section-heading { display: grid; grid-template-columns: minmax(130px, .34fr) 1fr minmax(260px, .6fr); gap: clamp(28px, 5vw, 80px); align-items: start; margin-bottom: clamp(70px, 9vw, 125px); } .section-heading .section-number { margin-top: 9px; }
  .section-heading h2, .practice h2, .about h2, .instructor h2, .contact h2 { margin: 0; font: 650 clamp(2.5rem, 5vw, 5.5rem)/.96 var(--display); letter-spacing: -.05em; text-wrap: balance; } .section-heading > p:last-child { margin: 7px 0 0; max-width: 520px; font-size: 17px; }
  .region-map { position: relative; min-height: 440px; margin-bottom: 90px; overflow: hidden; border: 1px solid var(--ink); background: var(--rice); } .region-map::before, .region-map::after { content: ''; position: absolute; border: 1px solid color-mix(in oklch, var(--ink) 28%, transparent); border-radius: 50%; } .region-map::before { width: 620px; height: 620px; left: 12%; top: -52%; } .region-map::after { width: 360px; height: 360px; right: 8%; bottom: -50%; }
  .region-map > p { position: absolute; left: 5%; bottom: 8%; margin: 0; font: 650 clamp(2rem, 4vw, 4.5rem)/.92 var(--display); letter-spacing: -.05em; } .map-line { position: absolute; height: 1px; background: var(--ink); transform-origin: left; opacity: .45; } .line-one { width: 72%; left: 18%; top: 28%; transform: rotate(13deg); } .line-two { width: 56%; left: 31%; top: 62%; transform: rotate(-18deg); }
  .map-point { position: absolute; display: inline-flex; align-items: center; gap: 9px; font: 650 11px/1 var(--display); letter-spacing: .03em; text-transform: uppercase; } .map-point i { display: block; width: 9px; height: 9px; border-radius: 50%; background: var(--coral); box-shadow: 0 0 0 4px color-mix(in oklch, var(--coral) 25%, transparent); } .p-singapore { left: 63%; top: 68%; } .p-india { left: 35%; top: 44%; } .p-sea { left: 55%; top: 51%; } .p-east { left: 76%; top: 25%; }
  .question-list { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--ink); } .question-list article { display: grid; grid-template-rows: auto auto 1fr; gap: 19px; min-height: 260px; padding: 20px 24px 30px 0; border-bottom: 1px solid var(--ink); } .question-list article + article { padding-left: 24px; border-left: 1px solid var(--ink); } .question-list span { font: 650 11px var(--display); opacity: .55; } .question-list h3, .outcomes h3 { margin: 0; font: 650 24px/1.1 var(--display); letter-spacing: -.035em; } .question-list p, .outcomes p { align-self: end; margin: 0; font-size: 14px; line-height: 1.55; }
  .workshop { padding-top: 22px; } .workshop-ticket { padding: clamp(30px, 5vw, 70px); color: var(--paper); background: var(--green); border: 1px solid var(--green-dark); } .ticket-top, .ticket-bottom { display: flex; align-items: center; justify-content: space-between; gap: 25px; } .ticket-top { padding-bottom: 25px; border-bottom: 1px solid color-mix(in oklch, var(--paper) 42%, transparent); font: 650 11px/1 var(--display); letter-spacing: .07em; text-transform: uppercase; } .ticket-top p, .ticket-bottom p { margin: 0; }
  .workshop-ticket > h2 { margin: 70px 0 30px; color: var(--coral); font: 700 clamp(3.7rem, 9vw, 9.4rem)/.86 var(--display); letter-spacing: -.07em; } .workshop-lede { max-width: 780px; margin: 0; color: var(--paper); font-size: clamp(1.25rem, 2.1vw, 1.85rem); line-height: 1.42; }
  .workshop-body { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(45px, 10vw, 150px); margin: 80px 0 70px; padding-top: 28px; border-top: 1px solid color-mix(in oklch, var(--paper) 42%, transparent); } .workshop-body h3 { margin: 0 0 25px; color: var(--coral); font: 650 13px/1 var(--display); } .check-list { list-style: none; margin: 0; padding: 0; } .check-list li { position: relative; padding: 11px 0 11px 28px; border-bottom: 1px solid color-mix(in oklch, var(--paper) 25%, transparent); font-weight: 500; } .check-list li::before { content: '×'; position: absolute; left: 2px; top: 10px; color: var(--coral); font: 700 17px/1 var(--display); }
  .audience-list { display: flex; flex-wrap: wrap; gap: 8px; } .audience-list span { padding: 7px 10px; color: var(--paper); border: 1px solid color-mix(in oklch, var(--paper) 65%, transparent); border-radius: 999px; font: 600 13px/1 var(--display); } .access-note { max-width: 580px; margin: 30px 0 0; color: color-mix(in oklch, var(--paper) 85%, transparent); font-size: 14px; } .ticket-bottom { padding-top: 25px; border-top: 1px solid color-mix(in oklch, var(--paper) 42%, transparent); } .ticket-bottom p { color: color-mix(in oklch, var(--paper) 75%, transparent); font-size: 12px; } .ticket-bottom strong { font: 650 17px/1.3 var(--display); }
  .workshop-ticket .button-dark { color: var(--ink); background: var(--coral); border-color: var(--coral); } .workshop-ticket .button-dark:hover { color: var(--ink); background: var(--paper); border-color: var(--paper); }
  .corporate-callout { display: grid; grid-template-columns: minmax(130px, .34fr) 1fr .8fr; gap: clamp(28px, 5vw, 80px); align-items: start; margin-top: 18px; padding: 55px 50px; color: var(--ink); background: var(--coral); } .corporate-callout h3 { margin: 0; font: 650 clamp(2.2rem, 4vw, 4.3rem)/.97 var(--display); letter-spacing: -.05em; } .corporate-callout > p:nth-of-type(2) { margin: 5px 0 0; } .corporate-callout .text-link { grid-column: 3; margin-top: 30px; color: var(--ink); }
