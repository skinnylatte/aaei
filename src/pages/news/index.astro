---
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import '../../styles/news.css';
import { newsFront, TYPE_LABELS, formatDate, shortMonth, href, isExternal } from '../../lib/news';

const { featured, upcoming, open, latest } = await newsFront();
const day = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', timeZone: 'Asia/Singapore' });
const month = shortMonth;
const target = (external: boolean) => (external ? { target: '_blank', rel: 'noreferrer' } : {});
---

<SiteLayout title="News" description="Events, what we have been doing, announcements, opportunities, and reports from the conferences we attend." current="news">
  <div class="news">
    <h1 class="headline">News</h1>

    <div class="news-top">
      {featured.length > 0 && (
        <section class="news-features" aria-roledescription="carousel" aria-label="Featured stories" data-features>
          {featured.map((f, i) => (
            <a class="news-feature" href={href(f)} {...target(isExternal(f))} hidden={i > 0} aria-roledescription="slide" aria-label={`${i + 1} of ${featured.length}`}>
              {f.data.image && <Image class="news-feature-image" src={f.data.image} alt="" widths={[640, 1280]} sizes="(max-width: 760px) 100vw, 60vw" />}
              <span class="news-feature-tag">{TYPE_LABELS[f.data.type]}{f.data.place && ` · ${f.data.place}`}</span>
              <span class="news-feature-title">{f.data.title}</span>
              <span class="news-feature-summary">{f.data.summary}</span>
              <span class="news-feature-more">Read more <span aria-hidden="true">→</span></span>
            </a>
          ))}
          {featured.length > 1 && (
            <div class="news-features-nav" hidden data-features-nav>
              <button type="button" data-step="-1" aria-label="Previous featured story"><span aria-hidden="true">←</span></button>
              <span class="news-features-count" aria-live="polite" data-features-count>1 / {featured.length}</span>
              <button type="button" data-step="1" aria-label="Next featured story"><span aria-hidden="true">→</span></button>
            </div>
          )}
        </section>
      )}
      {upcoming.length > 0 && (
        <aside class="news-coming" aria-labelledby="news-coming-title">
          <h2 id="news-coming-title" class="news-kicker">Coming up</h2>
          {upcoming.map((e) => (
            <a class="news-event" href={href(e)} {...target(isExternal(e))}>
              <span class="news-event-date"><span>{month(e.data.starts!)}</span><strong>{day(e.data.starts!)}</strong></span>
              <span class="news-event-body">
                <span class="news-event-title">{e.data.title}</span>
                {e.data.place && <span>{e.data.place}</span>}
                <span class="news-event-more">{e.data.linkLabel ?? 'Details'} <span aria-hidden="true">{isExternal(e) ? '↗' : '→'}</span></span>
              </span>
            </a>
          ))}
        </aside>
      )}
    </div>

    {open.length > 0 && (
      <section class="news-opps" aria-labelledby="news-opps-title">
        <div class="news-opps-head">
          <h2 id="news-opps-title">Opportunities</h2>
          <p>Jobs, calls, fellowships and grants we think our community should know about.</p>
        </div>
        <div class="news-opps-grid">
          {open.map((o) => (
            <a class="news-opp" href={href(o)} {...target(isExternal(o))}>
              {o.data.deadline && <span class="news-opp-deadline">Closes {formatDate(o.data.deadline)}</span>}
              <span class="news-opp-title">{o.data.title}</span>
              <span>{[o.data.organization, o.data.summary].filter(Boolean).join(' · ')}</span>
              <span class="news-opp-more">{o.data.linkLabel ?? 'Apply'} <span aria-hidden="true">{isExternal(o) ? '↗' : '→'}</span></span>
            </a>
          ))}
        </div>
        <a class="news-opps-all" href="/news/opportunities/">View all opportunities <span aria-hidden="true">→</span></a>
      </section>
    )}

    {latest.length > 0 && (
      <section class="news-latest" aria-labelledby="news-latest-title">
        <h2 id="news-latest-title">Latest</h2>
        <div class="news-grid">
          {latest.map((p) => (
            <a class="news-card" href={href(p)} {...target(isExternal(p))}>
              {p.data.image && <Image class="news-card-image" src={p.data.image} alt="" widths={[400, 800]} sizes="(max-width: 760px) 100vw, 33vw" />}
              <span class="news-kicker">{TYPE_LABELS[p.data.type]} · Posted on <time datetime={p.data.date.toISOString().slice(0, 10)}>{formatDate(p.data.date)}</time></span>
              <span class="news-card-title">{p.data.title}{isExternal(p) && <span aria-hidden="true"> ↗</span>}</span>
              <span>{p.data.summary}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</SiteLayout>

<script>
  // Arrows step through the featured stories. Without JavaScript the first story shows on its own.
  document.querySelectorAll<HTMLElement>('[data-features]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('.news-feature')];
    const nav = root.querySelector<HTMLElement>('[data-features-nav]');
    const count = root.querySelector<HTMLElement>('[data-features-count]');
    if (!nav || slides.length < 2) return;
    let current = 0;
    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, j) => { s.hidden = j !== current; });
      count!.textContent = `${current + 1} / ${slides.length}`;
    };
    nav.hidden = false;
    nav.addEventListener('click', (e) => {
      const step = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-step]')?.dataset.step;
      if (step) show(current + Number(step));
    });
  });
</script>
